//@version=6
// Versie: 1.1.1
//   1.1.1 - Rechthoeken lopen van de wick van de eerste tot de wick van de laatste candle
//           van het 30m-blok (niet meer tot in de candle erna). Versienummer toegevoegd.
//   1.1.0 - Rechthoeken in plaats van lijnen.
//   1.0.0 - Hoog/laag van de huidige en vorige 30m-candle als lijnen.
indicator("30m Range", shorttitle = "30m Range", overlay = true, max_boxes_count = 10)

// Versie-info: zichtbaar in het Inputs-tabblad van de instellingen.
scriptVersion = input.string("1.1.1", "Versie", options = ["1.1.1"], group = "Info")

// ─── Instellingen ───────────────────────────────────────────────
// Rand op volle kleur, vulling zeer transparant: de candles en andere lijnen blijven goed leesbaar.
colCur   = input.color(color.new(color.teal, 0),   "Kleur huidige 30m-candle")
colPrev  = input.color(color.new(color.orange, 0), "Kleur vorige 30m-candle")
fillTr   = input.int(88, "Transparantie vulling (%)", minval = 50, maxval = 100, tooltip = "100 = geen vulling, alleen de rand")
bw       = input.int(1, "Randdikte", minval = 0, maxval = 4, tooltip = "0 = geen rand")
styleStr = input.string("Solid", "Randstijl", options = ["Solid", "Dashed", "Dotted"])
bStyle   = styleStr == "Dashed" ? line.style_dashed : styleStr == "Dotted" ? line.style_dotted : line.style_solid

// Alleen tonen op intraday-charts kleiner dan 30 minuten (1m, 5m, 15m, ...)
showTF = timeframe.isintraday and timeframe.in_seconds() < 1800

// ─── 30m-candle bijhouden ───────────────────────────────────────
t30   = time("30")                              // starttijd van de 30m-candle waar deze bar in valt
isNew = na(t30[1]) or t30 != t30[1]

var float curH  = na
var float curL  = na
var int   curT  = na
var float prvH  = na
var float prvL  = na
var int   prvT  = na
var int   prvLast = na                       // tijd van de laatste bar binnen de vorige 30m-candle

if isNew
    // huidige wordt vorige; eindigt op de laatste bar daarvan (de vorige chartbar)
    prvH    := curH
    prvL    := curL
    prvT    := curT
    prvLast := time[1]
    // nieuwe huidige candle starten
    curH   := high
    curL   := low
    curT   := t30
else
    curH := math.max(curH, high)
    curL := math.min(curL, low)

// ─── Tekenen (alleen op de laatste bar → nooit geschiedenis) ────
var box bCur = na
var box bPrv = na

// Een box-rand ligt in TradingView altijd op het midden (de wick) van een candle; tijden
// daartussen worden afgerond. Beide zijden lopen daarom van de wick van de eerste tot de
// wick van de laatste candle van het blok.
f_box(int t1, float top, int t2, float bot, color c) =>
    box.new(t1, top, t2, bot, xloc = xloc.bar_time,
         border_color = bw == 0 ? na : c, border_width = bw, border_style = bStyle,
         bgcolor = color.new(c, fillTr))

if barstate.islast and showTF
    box.delete(bCur)
    box.delete(bPrv)

    // Vorige 30m: van de eerste tot en met de laatste bar van die candle
    if not na(prvH)
        bPrv := f_box(prvT, prvH, prvLast, prvL, colPrev)

    // Huidige 30m: van de eerste bar tot en met de actuele bar (groeit live mee)
    bCur := f_box(curT, curH, time, curL, colCur)
