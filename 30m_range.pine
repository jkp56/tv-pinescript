//@version=6
indicator("30m Range", shorttitle = "30m Range", overlay = true, max_boxes_count = 10)

// ─── Instellingen ───────────────────────────────────────────────
// Rand op volle kleur, vulling zeer transparant: de candles en andere lijnen blijven goed leesbaar.
colCur   = input.color(color.new(color.teal, 0),   "Kleur huidige 30m-candle")
colPrev  = input.color(color.new(color.orange, 0), "Kleur vorige 30m-candle")
fillTr   = input.int(88, "Transparantie vulling (%)", minval = 50, maxval = 100, tooltip = "100 = geen vulling, alleen de rand")
bw       = input.int(1, "Randdikte", minval = 0, maxval = 4, tooltip = "0 = geen rand")
styleStr = input.string("Solid", "Randstijl", options = ["Solid", "Dashed", "Dotted"])
bStyle   = styleStr == "Dashed" ? line.style_dashed : styleStr == "Dotted" ? line.style_dotted : line.style_solid

// Alleen tonen op intraday-charts kleiner dan 30 minuten (1m, 5m, 15m, ...)
showTF = timeframe.isintraday and timeframe.in_seconds() < 1800

// ─── 30m-candle bijhouden ───────────────────────────────────────
t30   = time("30")                              // starttijd van de 30m-candle waar deze bar in valt
isNew = na(t30[1]) or t30 != t30[1]

var float curH  = na
var float curL  = na
var int   curT  = na
var float prvH  = na
var float prvL  = na
var int   prvT  = na
var int   prvEnd = na

if isNew
    // huidige wordt vorige; eindtijd = start van de nieuwe 30m-candle
    prvH   := curH
    prvL   := curL
    prvT   := curT
    prvEnd := t30
    // nieuwe huidige candle starten
    curH   := high
    curL   := low
    curT   := t30
else
    curH := math.max(curH, high)
    curL := math.min(curL, low)

// ─── Tekenen (alleen op de laatste bar → nooit geschiedenis) ────
var box bCur = na
var box bPrv = na

f_box(int t1, float top, int t2, float bot, color c) =>
    box.new(t1, top, t2, bot, xloc = xloc.bar_time,
         border_color = bw == 0 ? na : c, border_width = bw, border_style = bStyle,
         bgcolor = color.new(c, fillTr))

if barstate.islast and showTF
    box.delete(bCur)
    box.delete(bPrv)

    // Vorige 30m: van start tot exact het einde van die candle
    if not na(prvH)
        bPrv := f_box(prvT, prvH, prvEnd, prvL, colPrev)

    // Huidige 30m: van start candle tot en met de actuele bar (groeit live mee)
    bCur := f_box(curT, curH, time_close, curL, colCur)
