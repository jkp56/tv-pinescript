//@version=6
// Versie: 1.4.0
//   1.4.0 - Break-tolerantie als % van het S/R-level (standaard 0,01%) i.p.v.
//           10 ticks (indicator v1.10.0). Alleen de close telt, wicks niet.
//   1.3.0 - Flip (tradeplan, entry-criterium): volgende 30m-candle tegengesteld
//           met body >= 0,12R, niet meer dan 0,6R terug vanaf de break-close.
//           Entry daarna als stop-order op de break-prijs. Standaard aan.
//   1.2.0 - Break-even (tradeplan): raakt prijs +0,8R, dan gaat de SL naar
//           de entry. Standaard aan, trigger en niveau instelbaar.
//   1.1.0 - Labels via instellingen, standaard uit: labels bij entry/SL/TP-lijnen
//           (nieuw) en label bij overgeslagen geldig signaal.
//   1.0.1 - Niet-mogelijke trades worden volledig genegeerd: geen label meer.
//   1.0.0 - Eerste versie: strategie-variant van trade_lines.pine (v1.9.38).
//
// Trade Lijnen - strategie (backtest)
// ------------------------------------------------------------
// Zelfde detectie als de indicator trade_lines.pine: Resistance/Support,
// Targets, breakout-signaal, SL, TP en de Trade Mogelijkheid-check (Range,
// max. R, optionele rejection candle) draaien ongewijzigd via
// request.security() op het 30m-timeframe van de rekenfeed.
//
// Is de trade op de signaal-candle mogelijk (zelfde voorwaarde als waarbij de
// indicator een TP-lijn tekent), dan opent de strategie een positie:
//   - Flip (standaard aan): de volgende 30m-candle moet tegengesteld zijn met
//            body >= 0,12R en mag niet meer dan 0,6R terugvallen. Daarna een
//            stop-order op de break-prijs (close van de signaal-candle).
//   - Entry zonder flip: market op de close van de signaal-candle.
//   - SL:    low - x ticks (Long) / high + x ticks (Short) van de signaal-candle.
//            Met "SL: trailing" aan schuift de SL mee binnen het signaalvenster,
//            maar alleen in het voordeel van de trade.
//   - Break-even: raakt prijs +0,8R (vanaf de fill), dan gaat de SL naar de
//            entry (fill-prijs). Eenmalig per trade.
//   - TP:    entry +/- tpRR * R.
//   - Optioneel: sluiten na x 30m-candles en/of op een vast uur.
//
// Let op de rekenfeed: staat "Berekeningen op andere feed" aan, dan komen
// signaal, SL en TP van FXCM, maar vult de backtest op de prijzen van de
// chart (bijv. FTMO_OANDA) - precies zoals je in de praktijk handelt. Voor
// een backtest puur op één feed: zet die optie uit.
//
// Alleen 30m- en 15m-chart. Op 15m vallen entries op de close van de tweede
// 15m-candle van de signaal-30m-candle (= de 30m-close).
// ------------------------------------------------------------
strategy("Trade Lijnen strategie (SL/S/R)", shorttitle = "Trade Lijnen strat", overlay = true,
     initial_capital = 10000, currency = currency.USD, pyramiding = 0,
     process_orders_on_close = true,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.03,
     margin_long = 5, margin_short = 5,
     max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// Versie-info: zichtbaar in het Inputs-tabblad van de instellingen.
scriptVersion = input.string("1.4.0", "Versie", options = ["1.4.0"], group = "Info")

// ============================================================
// REKENFEED: alle berekeningen (levels, signalen, SL/TP, Range-check) kunnen
// op een andere broker-feed van hetzelfde symbool draaien dan de chart zelf.
// Zo neem je de beslissing op FXCM (betrouwbaardere candles/overgangen)
// terwijl je op de FTMO_OANDA-chart kijkt en handelt. De lijnen staan dan op
// de FXCM-prijzen; tijd-coördinaten lopen gelijk, want beide feeds hebben
// dezelfde 30m-candles.
// ============================================================
useSourceFeed  = input.bool(true, "Berekeningen op andere feed dan de chart", group="Rekenfeed")
sourceExchange = input.string("FX", "Exchange-prefix van de rekenfeed (FXCM = FX)", group="Rekenfeed")

// Vast timeframe waarop alle berekeningen draaien. Het script ondersteunt
// alleen dit timeframe en het kortere "15" timeframe waarop de lijnen van
// dit timeframe blijven getoond.
calcTF        = "30"
lowerTF       = "15"
isSupportedTF = timeframe.period == calcTF or timeframe.period == lowerTF

// Rekenfeed = zelfde ticker, andere exchange-prefix (bijv. FX:XAUUSD op een
// FTMO_OANDA:XAUUSD-chart; TradingView gebruikt voor FXCM de prefix FX).
// srcTag komt in de labels zodat zichtbaar is dat de waarden niet van de
// chart-feed zijn.
// OANDA noemt indices/grondstoffen anders dan FXCM (NAS100USD vs NAS100);
// f_fxcmTicker vertaalt die namen, andere tickers blijven ongewijzigd.
f_fxcmTicker(string t) =>
    switch t
        "NAS100USD" => "NAS100"
        "US30USD"   => "US30"
        "SPX500USD" => "SPX500"
        "DE30EUR"   => "GER30"
        "DE40EUR"   => "GER30"
        "UK100GBP"  => "UK100"
        "FR40EUR"   => "FRA40"
        "EU50EUR"   => "EUSTX50"
        "JP225USD"  => "JPN225"
        "AU200AUD"  => "AUS200"
        "HK33HKD"   => "HKG33"
        "WTICOUSD"  => "USOIL"
        "BCOUSD"    => "UKOIL"
        => t

usingOtherFeed = useSourceFeed and sourceExchange != "" and sourceExchange != syminfo.prefix
calcTicker     = usingOtherFeed ? sourceExchange + ":" + (sourceExchange == "FX" ? f_fxcmTicker(syminfo.ticker) : syminfo.ticker) : syminfo.tickerid
srcTag         = usingOtherFeed ? " (" + (sourceExchange == "FX" ? "FXCM" : sourceExchange) + ")" : ""

// ============================================================
// STOP LOSS (zelfde logica als de indicator)
// - Long SL = low van de signaal-candle min x ticks (wick telt mee)
// - Short SL = high van de signaal-candle plus x ticks
// - Signaalvenster: zolang een signaal actief is (slSignalWindow 30m-
//   candles) telt een nieuwe break in dezelfde richting niet.
// - Trailing (optioneel): binnen het venster werkt elke bullish (Long) resp.
//   bearish (Short) candle de SL bij; in de strategie alleen als de SL
//   daardoor dichter bij de prijs komt (nooit verder weg).
// ============================================================
trailSL        = input.bool(false, "SL: trailing (bijwerken bij elke nieuwe candle in het venster)", group="Stop Loss")
tickOffset     = input.int(50, "SL: aantal ticks van wick", minval=1, group="Stop Loss")
slSignalWindow = input.int(2, "Signaalvenster (aantal 30m-candles)", minval=1, group="Stop Loss")

// Break-even (tradeplan): "Op 0,8R schuif je de SL naar break even".
// Gemeten vanaf de fill-prijs van de positie (de echte entry op de chart-
// feed), met R uit de signaal-candle. Pas vanaf de candle NA de entry-candle;
// de SL wordt bijgewerkt op de close van de candle die de trigger raakt.
beOn      = input.bool(true, "Break-even aan", group="Break-even")
beTrigger = input.float(0.8, "SL verplaatsen zodra prijs (R) haalt", minval=0.01, step=0.1, group="Break-even")
beLevel   = input.float(0.0, "SL verplaatsen naar (R t.o.v. entry, 0 = break-even)", minval=-1.0, step=0.1, group="Break-even")

// Flip (tradeplan, entry-criterium): de eerste 30m-candle NA de breakout-
// candle moet tegengesteld zijn (bearish bij Long, bullish bij Short) met een
// body van minimaal flipMinRR * R. Valt die candle meer dan flipMaxRR * R
// terug vanaf de close van de breakout-candle, dan wordt de trade
// overgeslagen. R, SL en TP blijven die van de breakout-candle; de entry komt
// na de flip als stop-order op de break-prijs (close van de breakout-candle).
flipOn        = input.bool(true, "Flip vereist (volgende 30m-candle tegengesteld aan de breakout-candle)", group="Flip")
flipMinRR     = input.float(0.12, "Flip: minimale body (R)", minval=0.0, step=0.01, group="Flip")
flipMaxRR     = input.float(0.6, "Overslaan als de flip-candle meer dan x R terugvalt vanaf de break-close", minval=0.01, step=0.05, group="Flip")
flipPullMode  = input.string("Wick", "Terugval meten op", options=["Wick", "Close"], group="Flip", tooltip="Wick: low (Long) / high (Short) van de flip-candle. Close: de close van de flip-candle.")
flipEntryMode = input.string("Op break-prijs (stop-order)", "Entry na de flip", options=["Op break-prijs (stop-order)", "Market op close flip-candle"], group="Flip", tooltip="Stop-order: entry zodra de prijs terugkomt op de close van de breakout-candle; R, SL en TP precies zoals bij de break. Market: direct op de close van de flip-candle, SL en TP blijven op dezelfde prijzen.")
flipOrderBars = input.int(4, "Stop-order vervalt na x 30m-candles", minval=1, group="Flip", tooltip="Ook geannuleerd als de prijs eerst de SL raakt, op het sluituur of bij een nieuw signaal.")

// ============================================================
// RESISTANCE / SUPPORT (volledig automatisch, altijd op 30m-candles)
// Zie "T4G daytrade rules.md" voor de volledige detectielogica (bullish->
// bearish resp. bearish->bullish overgang op body-niveau, wick-gratieperiode
// voor de Target-lijnen, body-toleranties, dagsluiting/weekend-gap, enz.).
// ============================================================
maxScanBars      = input.int(450, "Max bars terugzoeken", minval=10, maxval=500, group="Support / Resistance")
autoTargetTicks  = input.int(100, "Fallback afstand target lijnen (ticks, alleen als geen geldige overgang gevonden wordt)", minval=1, group="Support / Resistance")
minTargetDistance = input.int(300, "Minimale afstand Target t.o.v. Resistance/Support (ticks)", minval=1, group="Support / Resistance")
excludeReversalCandle = input.bool(true, "Support/Resistance: reversal-candle uitsluiten van eigen invalidatie", group="Support / Resistance")
bodyTolEnabled   = input.bool(false, "Body-tolerantie voor candle na de overgang", group="Support / Resistance")
bodyTolTicks     = input.int(50, "Body-tolerantie (ticks)", minval=1, group="Support / Resistance")
laterTolEnabled  = input.bool(false, "Body-tolerantie voor alle latere candles", group="Support / Resistance")
laterTolTicks    = input.int(50, "Body-tolerantie latere candles (ticks)", minval=1, group="Support / Resistance")
sessionGapOpen   = input.bool(true, "Overgang over dagsluiting/weekend: level = open van de reversal-candle", group="Support / Resistance")

// ============================================================
// SIGNAAL INSTELLINGEN
// ============================================================
// Break-tolerantie als percentage van het S/R-level: de 30m-close moet
// minimaal breakPct % voorbij Resistance (Long) resp. Support (Short) sluiten.
// Alleen de close telt, wicks spelen geen rol. Een percentage schaalt vanzelf
// mee met instrument en koersniveau (0,01% = ca. 0,40 op XAUUSD ~4000 en
// ca. 2,7 punt op NAS100 ~27000) en is direct na te meten met de price
// range tool van TradingView.
breakPct = input.float(0.01, "Break-tolerantie: close voorbij S/R (% van het level)", minval=0, step=0.005, group="Signaal instellingen", tooltip="De 30m-close moet minimaal dit percentage voorbij Resistance/Support sluiten. Wicks tellen niet mee. 0,01% = ca. 0,40 op XAUUSD (~4000) en ca. 2,7 punt op NAS100 (~27000). Na te meten met de price range tool van TradingView.")

// ============================================================
// TRADE MOGELIJKHEID: TP (bij ingestelde R/R) + Range-check
// - R = verschil tussen de close van de signaal-candle en de waarde van de
//   SL-lijn bij dat signaal (zelfde formule als de Long/Short SL):
//     Long:  SL = low  van de signaal-candle - x ticks  ->  R = close - SL
//     Short: SL = high van de signaal-candle + x ticks  ->  R = SL - close
// - TP = entry (= close van de signaal-candle) +/- tpRR * R.
// - Range = vrije ruimte voor de trade: afstand tussen entry en Target
//   Resistance (Long), resp. tussen entry en Target Support (Short) - het
//   Target zoals het op de chart stond op het moment van de break (de
//   PRE-update waarde, net als de doorbroken Resistance/Support zelf), dus
//   niet zoals het op de signaal-candle of daarna opnieuw getekend wordt.
//   Bewust NIET gemeten
//   vanaf het (verschoven) Resistance/Support-level: dat kan vlak bij het
//   Target liggen, waardoor de Range kunstmatig klein wordt terwijl de
//   trade zelf ruim baan heeft.
// - Trade alleen mogelijk als die Range minimaal minRangeRR * R kan bevatten
//   EN R (in ticks) niet groter is dan maxRTicks. Zo niet: het signaal
//   wordt volledig genegeerd (geen trade, geen label, geen lijnen).
// - Rejection candle (optioneel, standaard uit - komt uit de NASDAQ-
//   strategie): sluit de tweede 15m-candle van de breakout-30m-candle tegen
//   de trade-richting in (bearish bij Long, bullish bij Short) met een body
//   van minimaal rejectionTicks, dan is de trade ook niet mogelijk. Een doji
//   of kleinere tegengestelde body telt niet als rejection.
// ============================================================
tpRR           = input.float(1.2, "TP: Risk/Reward ratio", minval=0.01, step=0.1, group="Trade Mogelijkheid")
minRangeRR     = input.float(1.0, "Minimaal benodigde R/R-ruimte in de Range", minval=0.01, step=0.1, group="Trade Mogelijkheid")
maxRTicks      = input.int(1000, "Maximaal toegestane R (ticks)", minval=1, group="Trade Mogelijkheid")
rejectionOn    = input.bool(false, "Rejection candle (15m) maakt trade ongeldig", group="Trade Mogelijkheid")
rejectionTicks = input.int(50, "Rejection candle: minimale tegengestelde body (ticks)", minval=1, group="Trade Mogelijkheid")

// ============================================================
// STRATEGIE: welke signalen, wanneer sluiten, backtest-periode.
// ============================================================
tradeDir       = input.string("Long en Short", "Richting", options=["Long en Short", "Alleen Long", "Alleen Short"], group="Strategie")
ignoreInPos    = input.bool(true, "Nieuwe signalen negeren zolang er een positie open is", group="Strategie", tooltip="Uit: een tegengesteld signaal keert de positie om (de oude wordt op de close gesloten).")
maxHoldBars    = input.int(0, "Sluiten na x 30m-candles (0 = uit)", minval=0, group="Strategie")
useExitHour    = input.bool(false, "Alles sluiten op vast uur", group="Strategie")
exitHour       = input.int(22, "Sluituur", minval=0, maxval=23, group="Strategie")
tz             = input.string("Europe/Amsterdam", "Tijdzone (sluituur)", group="Strategie")
startDate      = input.time(timestamp("2024-01-01T00:00:00"), "Backtest vanaf", group="Strategie")
endDate        = input.time(timestamp("2099-12-31T00:00:00"), "Backtest tot", group="Strategie")

// ============================================================
// POSITIEGROOTTE: zelfde formule als de lotgrootte in de indicator,
//   units = (equity * risico%) / (R * puntwaarde * koers-naar-USD + commissie per unit)
// naar beneden afgerond op qtyStep (minimaal 1 stap). XAUUSD: 1 unit = 1 oz,
// 100 units = 1 lot, stap 1 = 0,01 lot. Commissie in de backtest zelf staat in
// het Properties-tabblad (standaard $0,03 per unit per kant = $6 per lot
// round-trip).
// ============================================================
sizeMode     = input.string("Risico % van equity", "Positiegrootte", options=["Risico % van equity", "Risico % van vast saldo", "Vaste lotgrootte"], group="Positiegrootte")
riskPct      = input.float(1.0, "Risico per trade (%)", minval=0.01, step=0.1, group="Positiegrootte")
fixedBalance = input.float(10000, "Vast saldo ($)", minval=1, group="Positiegrootte")
fixedLots    = input.float(0.10, "Vaste lotgrootte (lots)", minval=0.01, step=0.01, group="Positiegrootte")
contractSize = input.float(100, "Contractgrootte (units per lot, XAUUSD = 100)", minval=0.000001, group="Positiegrootte")
commPerLot   = input.float(6, "Commissie per lot round-trip ($, voor de sizing)", minval=0, step=0.5, group="Positiegrootte")
qtyStep      = input.float(1.0, "Afronding positiegrootte (units)", minval=0.0001, group="Positiegrootte")

// ============================================================
// WEERGAVE
// ============================================================
showSR         = input.bool(true, "Toon actuele Resistance/Support/Target-lijnen", group="Weergave")
showTradeLines = input.bool(true, "Toon entry/SL/TP-lijnen per trade", group="Weergave")
showTradeLabels = input.bool(false, "Toon labels bij entry/SL/TP-lijnen (prijs, lotgrootte, R)", group="Weergave")
showNoTrade    = input.bool(false, "Toon label bij geldig signaal dat niet getraded is (met reden)", group="Weergave", tooltip="Alleen signalen waarbij de trade WEL mogelijk was, maar die overgeslagen zijn (positie al open, richting uit, sluituur). Niet-mogelijke trades worden nooit getoond.")
lineLen        = input.int(5, "Lengte trade-lijnen (aantal 30m-candles)", minval=1, group="Weergave")
labelTextColor = input.color(color.black, "Labelkleur (tekst)", group="Weergave")

tickSize = syminfo.mintick
slOffset = tickOffset * tickSize
bodyTol  = bodyTolTicks * tickSize
laterTol = laterTolEnabled ? laterTolTicks * tickSize : 0.0

// Omrekenkoers van de noteringsvaluta naar USD (1 voor XAUUSD en andere
// xxxUSD-symbolen).
fxRate     = request.currency_rate(syminfo.currency, "USD", ignore_invalid_currency=true)
quoteToUsd = syminfo.currency == "USD" ? 1.0 : nz(fxRate, 1.0)

// Range uitgedrukt in R, naar beneden afgerond op 2 decimalen: zo toont een
// net-niet-gehaalde check (bijv. 0.997R) nooit misleidend "1R < 1R".
f_fmtRR(float x) =>
    na(x) ? "-" : str.tostring(math.floor(x * 100) / 100, "0.00")

max_bars_back(open, 500)
max_bars_back(close, 500)
max_bars_back(high, 500)
max_bars_back(low, 500)
max_bars_back(time, 500)

// ============================================================
// PURE HELPER FUNCTIES.
// Deze functies geven een OFFSET ("aantal candles terug") terug i.p.v.
// een absolute bar_index, zodat we er zowel de tekst ("X candles terug")
// als de exacte tijd (via time[offset]) uit kunnen afleiden - nodig om de
// lijnen straks tijd-gebaseerd te kunnen tekenen.
// ============================================================
f_bodyTop(i) => math.max(open[i], close[i])
f_bodyBottom(i) => math.min(open[i], close[i])
f_validBar(i) => open[i] > 0 and close[i] > 0 and high[i] > 0 and low[i] > 0

// Ligt er tussen de pivot-candle (offset i+1) en de reversal-candle (offset
// i) een tijdsgat (dagsluiting of weekend)? Dan is de close van de pivot-
// candle geen betrouwbaar level: die valt vlak voor de sluiting (dunne
// handel, brede spread) en kan per broker flink verschillen. Het level wordt
// dan de open van de reversal-candle - de eerste prijs na de gap - zowel bij
// een gap up als een gap down. Zonder tijdsgat: gewoon de body van de pivot.
f_sessionGap(i) => sessionGapOpen and time[i] - time[i + 1] > timeframe.in_seconds(calcTF) * 1000
f_supportLevel(i) => f_sessionGap(i) ? open[i] : f_bodyBottom(i + 1)
f_resistanceLevel(i) => f_sessionGap(i) ? open[i] : f_bodyTop(i + 1)

f_safeHighest(length) =>
    float m = na
    for i = 0 to length - 1
        if f_validBar(i)
            m := na(m) ? high[i] : math.max(m, high[i])
    m

f_safeLowest(length) =>
    float m = na
    for i = 0 to length - 1
        if f_validBar(i)
            m := na(m) ? low[i] : math.min(m, low[i])
    m

// Body-geldigheid van een Support-kandidaat (pivot op offset i+1, reversal-
// candle op offset i). minTo1 = laagste body-onderkant van candles 0..i-1,
// minTo2 = idem van candles 0..i-2 (dus zonder de candle direct na de
// reversal-candle). Strikt: geen enkele latere body onder het level.
// Body-tolerantie (optioneel): de candle direct na de reversal-candle mag met
// zijn body maximaal bodyTol onder het level komen, mits die candle zelf
// bullish is (de respecterende richting voor Support) - zo'n candle opent
// net iets lager maar sluit erboven.
// Body-tolerantie latere candles (optioneel, laterTol): ELKE latere body -
// ongeacht kleur - mag maximaal laterTol onder het level komen. Vangt feed-
// ruis op waarbij bijv. een break-candle op de ene broker net onder en op de
// andere net boven het level sluit. Staat die uit, dan is laterTol 0 (strikt).
f_supportBodyValid(i, candidate, minTo1, minTo2, excludeReversal) =>
    bottomI = f_bodyBottom(i)
    fullMin = excludeReversal ? minTo1 : (na(minTo1) ? bottomI : math.min(minTo1, bottomI))
    bool valid = na(fullMin) or fullMin >= candidate - laterTol
    if not valid and bodyTolEnabled and i >= 1
        k = i - 1
        restMin = excludeReversal ? minTo2 : (na(minTo2) ? bottomI : math.min(minTo2, bottomI))
        if f_validBar(k) and close[k] > open[k] and f_bodyBottom(k) >= candidate - math.max(bodyTol, laterTol) and (na(restMin) or restMin >= candidate - laterTol)
            valid := true
    valid

// Spiegelbeeld voor Resistance: maxTo1/maxTo2 = hoogste body-bovenkant, de
// candle na de reversal-candle moet bearish zijn om de tolerantie te krijgen.
// laterTol werkt hier boven het level.
f_resistanceBodyValid(i, candidate, maxTo1, maxTo2, excludeReversal) =>
    topI = f_bodyTop(i)
    fullMax = excludeReversal ? maxTo1 : (na(maxTo1) ? topI : math.max(maxTo1, topI))
    bool valid = na(fullMax) or fullMax <= candidate + laterTol
    if not valid and bodyTolEnabled and i >= 1
        k = i - 1
        restMax = excludeReversal ? maxTo2 : (na(maxTo2) ? topI : math.max(maxTo2, topI))
        if f_validBar(k) and close[k] < open[k] and f_bodyTop(k) <= candidate + math.max(bodyTol, laterTol) and (na(restMax) or restMax <= candidate + laterTol)
            valid := true
    valid

// Wick-check voor de Target-lijnen. De reversal-candle (offset pivotOffset-1)
// hoort bij de overgang zelf en wordt niet gecontroleerd. De eerste candle NA
// de overgang (offset pivotOffset-2) mag het level met een wick raken
// (gratie), maar alleen als hij in de respecterende richting sluit: bearish
// bij Resistance, bullish bij Support. Elke candle daarna - ongeacht kleur -
// maakt het level ongeldig ("uitgenomen") zodra de wick het raakt.
f_wickValidAboveLevel(pivotOffset, level) =>
    bool valid = true
    if pivotOffset >= 2
        for k = pivotOffset - 2 to 0
            if f_validBar(k)
                graced = k == pivotOffset - 2 and close[k] < open[k]
                if not graced and high[k] >= level
                    valid := false
                    break
    valid

f_wickValidBelowLevel(pivotOffset, level) =>
    bool valid = true
    if pivotOffset >= 2
        for k = pivotOffset - 2 to 0
            if f_validBar(k)
                graced = k == pivotOffset - 2 and close[k] > open[k]
                if not graced and low[k] <= level
                    valid := false
                    break
    valid

// Resistance: bullish -> bearish overgang, body-top. Eerste geldige
// (bodyValid) pivot-level, ongeacht wicks - dit is puur de dichtstbijzijnde
// aanzet; of dit level uiteindelijk het getoonde Resistance-level blijft of
// verschuift naar een tussenliggend level hangt af van de Target-zoektocht
// verderop (zie f_autoTargetResistance). Retourneert [level, barsBack].
f_autoResistance(maxScan, excludeReversal) =>
    float level = na
    int barsBack = na
    float maxTo1 = na
    float maxTo2 = na
    for i = 0 to maxScan - 2
        if f_validBar(i) and f_validBar(i + 1) and close[i + 1] > open[i + 1] and close[i] < open[i]
            candidate = f_resistanceLevel(i)
            if f_resistanceBodyValid(i, candidate, maxTo1, maxTo2, excludeReversal)
                level := candidate
                barsBack := i + 1
                break
        maxTo2 := maxTo1
        if f_validBar(i)
            maxTo1 := na(maxTo1) ? f_bodyTop(i) : math.max(maxTo1, f_bodyTop(i))
    [level, barsBack]

// Support: spiegelbeeld van Resistance. Retourneert [level, barsBack].
f_autoSupport(maxScan, excludeReversal) =>
    float level = na
    int barsBack = na
    float minTo1 = na
    float minTo2 = na
    for i = 0 to maxScan - 2
        if f_validBar(i) and f_validBar(i + 1) and close[i + 1] < open[i + 1] and close[i] > open[i]
            candidate = f_supportLevel(i)
            if f_supportBodyValid(i, candidate, minTo1, minTo2, excludeReversal)
                level := candidate
                barsBack := i + 1
                break
        minTo2 := minTo1
        if f_validBar(i)
            minTo1 := na(minTo1) ? f_bodyBottom(i) : math.min(minTo1, f_bodyBottom(i))
    [level, barsBack]

// Target Resistance: EIGEN zoektocht. Zoekt het EERSTE bodyValid pivot-level
// dat ZOWEL ver genoeg (minDistance) van Resistance ligt ALS wick-valid is -
// dat wordt het Target, en de zoektocht stopt daar. Onderweg wordt ook het
// LAATSTE bodyValid level bijgehouden dat niet aan beide eisen voldeed (dus
// te dichtbij lag, of al eerder met een wick geraakt is) - dat is het level
// waar Resistance eventueel naar verschuift. Resistance vereist zelf GEEN
// wick-validiteit (net als f_autoResistance) - alleen de Target-lijn zelf
// moet nog "schoon" (ongeraakt) zijn (zie f_calc30m: shift gebeurt alleen als
// er een Target gevonden is EN er zo'n tussenliggend level bestaat; anders
// blijven Resistance en Target zoals ze zijn). Retourneert
// [level, barsBack, shiftLevel, shiftBarsBack].
f_autoTargetResistance(maxScan, resistanceLevel, minDistance, excludeReversal) =>
    float level = na
    int barsBack = na
    float shiftLevel = na
    int shiftBarsBack = na
    float maxTo1 = na
    float maxTo2 = na
    for i = 0 to maxScan - 2
        if f_validBar(i) and f_validBar(i + 1) and close[i + 1] > open[i + 1] and close[i] < open[i]
            candidate = f_resistanceLevel(i)
            bodyValid = f_resistanceBodyValid(i, candidate, maxTo1, maxTo2, excludeReversal)
            if bodyValid
                if (candidate - resistanceLevel) >= minDistance and f_wickValidAboveLevel(i + 1, candidate)
                    level := candidate
                    barsBack := i + 1
                    break
                else
                    shiftLevel := candidate
                    shiftBarsBack := i + 1
        maxTo2 := maxTo1
        if f_validBar(i)
            maxTo1 := na(maxTo1) ? f_bodyTop(i) : math.max(maxTo1, f_bodyTop(i))
    [level, barsBack, shiftLevel, shiftBarsBack]

// Target Support: spiegelbeeld van f_autoTargetResistance. Support vereist
// zelf GEEN wick-validiteit (net als f_autoSupport) - alleen de Target-lijn
// zelf moet nog "schoon" zijn. Retourneert [level, barsBack, shiftLevel, shiftBarsBack].
f_autoTargetSupport(maxScan, supportLevel, minDistance, excludeReversal) =>
    float level = na
    int barsBack = na
    float shiftLevel = na
    int shiftBarsBack = na
    float minTo1 = na
    float minTo2 = na
    for i = 0 to maxScan - 2
        if f_validBar(i) and f_validBar(i + 1) and close[i + 1] < open[i + 1] and close[i] > open[i]
            candidate = f_supportLevel(i)
            bodyValid = f_supportBodyValid(i, candidate, minTo1, minTo2, excludeReversal)
            if bodyValid
                if (supportLevel - candidate) >= minDistance and f_wickValidBelowLevel(i + 1, candidate)
                    level := candidate
                    barsBack := i + 1
                    break
                else
                    shiftLevel := candidate
                    shiftBarsBack := i + 1
        minTo2 := minTo1
        if f_validBar(i)
            minTo1 := na(minTo1) ? f_bodyBottom(i) : math.min(minTo1, f_bodyBottom(i))
    [level, barsBack, shiftLevel, shiftBarsBack]

// Trade Mogelijkheid voor een signaal, dir = 1 (Long) of -1 (Short). R en
// Range zijn afstanden in de trade-richting: R = entry -> SL, Range = entry
// -> Target. body2 = close - open van de tweede 15m-candle van de signaal-
// candle (na als die niet beschikbaar is). Retourneert [tp, rangeRR, r, ok, reden].
f_tradeCheck(float entry, float sl, float target, int dir, float body2) =>
    r           = (entry - sl) * dir
    rTicks      = r / tickSize
    rangeAvail  = (target - entry) * dir
    rangeNeeded = minRangeRR * r
    rangeOk     = rangeAvail >= rangeNeeded
    rTooLarge   = rTicks > maxRTicks
    rejTicks    = -body2 * dir / tickSize
    rejected    = rejectionOn and not na(body2) and rejTicks >= rejectionTicks
    string reason = ""
    if not rangeOk
        reason := "Range " + f_fmtRR(rangeAvail / r) + "R < " + str.tostring(minRangeRR, "#.##") + "R (" + str.tostring(rangeAvail, format.mintick) + " < " + str.tostring(rangeNeeded, format.mintick) + ")"
    if rTooLarge
        reason := reason + (reason != "" ? "\n" : "") + "R " + str.tostring(rTicks, "#.##") + " ticks > max " + str.tostring(maxRTicks) + " ticks"
    if rejected
        reason := reason + (reason != "" ? "\n" : "") + "Rejection candle 15m (" + str.tostring(rejTicks, "#") + " ticks >= " + str.tostring(rejectionTicks) + ")"
    [entry + dir * tpRR * r, r > 0 ? rangeAvail / r : na, r, r > 0 and rangeOk and not rTooLarge and not rejected, reason]

// ============================================================
// ALLE BEREKENINGEN: draait via request.security() altijd op het 30m-
// timeframe, ook als de chart zelf op 15m staat. De "var" + barstate.
// isconfirmed-combinatie zorgt ervoor dat er nooit in een nog lopende
// (niet-afgesloten) 30m-candle gekeken wordt (geen repainting): zolang die
// candle nog loopt, blijven alle velden gewoon op hun laatst bevestigde
// waarde staan.
// ============================================================
f_calc30m() =>
    var float resistance       = na
    var float support          = na
    var float targetResistance = na
    var float targetSupport    = na
    var float prevResistance   = na
    var float prevSupport      = na
    var float prevTargetResistance = na
    var float prevTargetSupport    = na
    var rFallback  = bool(na)
    var sFallback  = bool(na)
    var trFallback = bool(na)
    var tsFallback = bool(na)
    var int   rPivotTime  = na
    var int   sPivotTime  = na
    var int   trPivotTime = na
    var int   tsPivotTime = na
    var int   rBarsBack   = na
    var int   sBarsBack   = na
    var int   trBarsBack  = na
    var int   tsBarsBack  = na

    var int barTime       = na

    var bool longActive   = false
    var bool shortActive  = false
    var int  lastLongBar  = na
    var int  lastShortBar = na

    var float longTrailSL  = na
    var float shortTrailSL = na
    var slSide             = bool(na)

    var float longBreakLevel  = na
    var float shortBreakLevel = na
    var float longBreakTarget  = na
    var float shortBreakTarget = na
    var int   breakTime       = na
    var breakSide             = bool(na)

    var bool   longTradeOk    = false
    var float  longTP         = na
    var string longReasonText = ""
    var float  longRangeRR    = na
    var float  longEntry      = na
    var float  longR          = na

    var bool   shortTradeOk    = false
    var float  shortTP         = na
    var string shortReasonText = ""
    var float  shortRangeRR    = na
    var float  shortEntry      = na
    var float  shortR          = na

    // De 15m-candles binnen deze 30m-candle (geneste request, draait dus ook
    // op de rekenfeed). Body van de tweede 15m-candle = close - open; na als
    // de 30m-candle niet uit twee 15m-candles bestaat (bijv. na een gap).
    bodies15 = request.security_lower_tf(calcTicker, lowerTF, close - open)
    float body2 = bodies15.size() == 2 ? bodies15.last() : na

    if barstate.isconfirmed
        barTime       := time

        // --- Resistance / Support / Targets ---
        prevResistance := resistance
        prevSupport    := support
        prevTargetResistance := targetResistance
        prevTargetSupport    := targetSupport

        [rawResistance, rBack] = f_autoResistance(maxScanBars, excludeReversalCandle)
        [rawSupport, sBack]    = f_autoSupport(maxScanBars, excludeReversalCandle)

        resistance := na(rawResistance) ? f_safeHighest(maxScanBars) : rawResistance
        support    := na(rawSupport) ? f_safeLowest(maxScanBars) : rawSupport
        rFallback  := na(rawResistance)
        sFallback  := na(rawSupport)
        rBarsBack  := na(rawResistance) ? maxScanBars : rBack
        sBarsBack  := na(rawSupport) ? maxScanBars : sBack

        [rawTargetResistance, trBack, rShiftLevel, rShiftBarsBack] = f_autoTargetResistance(maxScanBars, resistance, minTargetDistance * tickSize, excludeReversalCandle)
        [rawTargetSupport, tsBack, sShiftLevel, sShiftBarsBack]    = f_autoTargetSupport(maxScanBars, support, minTargetDistance * tickSize, excludeReversalCandle)

        // Resistance/Support verschuiven naar het laatste geldige tussenliggende
        // level vóór het gevonden Target - maar alleen als er ook daadwerkelijk
        // een Target gevonden is én er zo'n tussenliggend level bestaat. Is dat
        // niet het geval, dan blijven Resistance/Support en Target ongewijzigd.
        if not na(rawTargetResistance) and not na(rShiftLevel)
            resistance := rShiftLevel
            rBarsBack  := rShiftBarsBack
        if not na(rawTargetSupport) and not na(sShiftLevel)
            support    := sShiftLevel
            sBarsBack  := sShiftBarsBack

        rPivotTime := time[rBarsBack]
        sPivotTime := time[sBarsBack]

        fallbackTicks = math.max(autoTargetTicks, minTargetDistance)
        targetResistance := na(rawTargetResistance) ? resistance + fallbackTicks * tickSize : rawTargetResistance
        targetSupport    := na(rawTargetSupport) ? support - fallbackTicks * tickSize : rawTargetSupport
        trFallback := na(rawTargetResistance)
        tsFallback := na(rawTargetSupport)
        trBarsBack := na(rawTargetResistance) ? maxScanBars : trBack
        tsBarsBack := na(rawTargetSupport) ? maxScanBars : tsBack
        trPivotTime := time[trBarsBack]
        tsPivotTime := time[tsBarsBack]

        // --- Breakout-signalen (tegen de PRE-update Resistance/Support) ---
        bullishLevel = prevResistance * (1 + breakPct / 100)
        bearishLevel = prevSupport * (1 - breakPct / 100)

        // Was er al een actief signaal in dezelfde richting (op basis van de
        // ORIGINELE lastLongBar/lastShortBar, dus vóór de eventuele update
        // hieronder)? Zo ja, dan mag dit geen nieuwe break tellen: Support/
        // Resistance kan van candle op candle flink verspringen (het dichtst-
        // bijzijnde nog-niet-gebroken level verandert na een sterke beweging),
        // waardoor prevSupport/prevResistance - en dus bullishLevel/bearish-
        // Level - kan verschuiven zonder dat de markt echt opnieuw een level
        // doorbreekt. Zonder deze check vuurt zo'n verschuiving een tweede
        // (spurious) breakout af met een compleet andere, vaak veel grotere R,
        // puur omdat de drempel zelf is bijgesteld.
        wasLongActive  = not na(lastLongBar) and (bar_index - lastLongBar) < slSignalWindow
        wasShortActive = not na(lastShortBar) and (bar_index - lastShortBar) < slSignalWindow

        bullishBreakNow = not na(prevResistance) and close > bullishLevel and close[1] <= bullishLevel and not wasLongActive
        bearishBreakNow = not na(prevSupport) and close < bearishLevel and close[1] >= bearishLevel and not wasShortActive

        if bullishBreakNow
            lastLongBar    := bar_index
            breakSide      := true
            breakTime      := time
            longBreakLevel := bullishLevel
            longBreakTarget := prevTargetResistance

        if bearishBreakNow
            lastShortBar    := bar_index
            breakSide        := false
            breakTime         := time
            shortBreakLevel  := bearishLevel
            shortBreakTarget := prevTargetSupport

        longActive  := not na(lastLongBar) and (bar_index - lastLongBar) < slSignalWindow
        shortActive := not na(lastShortBar) and (bar_index - lastShortBar) < slSignalWindow

        // --- SL-weergave: op de signaal-candle zelf wordt de SL altijd gezet,
        // ongeacht de kleur van die candle (zelfde SL als in de Range-check
        // hieronder). Staat trailSL aan, dan werkt elke volgende candle van de
        // "juiste" kleur binnen het venster de getoonde SL nog bij; staat
        // trailSL uit (default), dan blijft de SL vanaf de signaal-candle vast
        // staan - net als de TP-lijn. ---
        if bullishBreakNow or (trailSL and longActive and close > open)
            longTrailSL := low - slOffset
            slSide      := true
        if bearishBreakNow or (trailSL and shortActive and close < open)
            shortTrailSL := high + slOffset
            slSide       := false

        // --- Trade Mogelijkheid: TP + Range-check, vast bepaald op de
        // signaal-candle zelf, blijft ongewijzigd zolang het venster loopt ---
        if bullishBreakNow and not na(prevTargetResistance)
            [lTp, lRangeRR, lR, lOk, lReason] = f_tradeCheck(close, low - slOffset, prevTargetResistance, 1, body2)
            longTP         := lTp
            longRangeRR    := lRangeRR
            longEntry      := close
            longR          := lR
            longTradeOk    := lOk
            longReasonText := lReason

        if bearishBreakNow and not na(prevTargetSupport)
            [sTp, sRangeRR, sR, sOk, sReason] = f_tradeCheck(close, high + slOffset, prevTargetSupport, -1, body2)
            shortTP         := sTp
            shortRangeRR    := sRangeRR
            shortEntry      := close
            shortR          := sR
            shortTradeOk    := sOk
            shortReasonText := sReason

    [resistance, support, targetResistance, targetSupport,
     rFallback, sFallback, trFallback, tsFallback,
     rPivotTime, sPivotTime, trPivotTime, tsPivotTime,
     rBarsBack, sBarsBack, trBarsBack, tsBarsBack,
     barTime,
     longActive, shortActive,
     longTrailSL, shortTrailSL, slSide,
     longBreakLevel, shortBreakLevel, longBreakTarget, shortBreakTarget, breakTime, breakSide,
     longTradeOk, longTP, longReasonText, longRangeRR, longEntry, longR,
     shortTradeOk, shortTP, shortReasonText, shortRangeRR, shortEntry, shortR]

// Let op: request.security() krijgt hier bewust een TUPLE van simpele
// waarden terug (niet een object van een user-defined type). Dat is de
// vorm die request.security() al sinds jaar en dag ondubbelzinnig
// ondersteunt; een UDT-object teruggeven bleek in de praktijk niet
// betrouwbaar te worden gevuld (alle velden bleven op hun startwaarde
// staan, waardoor er nergens meer iets werd getekend).
[calcResistance, calcSupport, calcTargetResistance, calcTargetSupport, calcRFallback, calcSFallback, calcTrFallback, calcTsFallback, calcRPivotTime, calcSPivotTime, calcTrPivotTime, calcTsPivotTime, calcRBarsBack, calcSBarsBack, calcTrBarsBack, calcTsBarsBack, calcBarTime, calcLongActive, calcShortActive, calcLongTrailSL, calcShortTrailSL, calcSlSide, calcLongBreakLevel, calcShortBreakLevel, calcLongBreakTarget, calcShortBreakTarget, calcBreakTime, calcBreakSide, calcLongTradeOk, calcLongTP, calcLongReasonText, calcLongRangeRR, calcLongEntry, calcLongR, calcShortTradeOk, calcShortTP, calcShortReasonText, calcShortRangeRR, calcShortEntry, calcShortR] = request.security(calcTicker, calcTF, f_calc30m(), lookahead=barmerge.lookahead_off)

// ============================================================
// Waarschuwing bij niet-ondersteund timeframe.
// ============================================================
var label tfWarnLabel = na
if barstate.islast
    label.delete(tfWarnLabel)
    tfWarnLabel := na
    if not isSupportedTF
        tfWarnLabel := label.new(bar_index, high, "Trade Lijnen strategie: alleen 30m en 15m worden ondersteund.\nSchakel naar 30m of 15m.", xloc.bar_index, yloc.abovebar, color.new(color.red, 0), label.style_label_down, color.white, size.normal)

// ============================================================
// STRATEGIE
// ============================================================
barMs      = timeframe.in_seconds(calcTF) * 1000
inWindow   = time >= startDate and time <= endDate
allowLong  = tradeDir != "Alleen Short"
allowShort = tradeDir != "Alleen Long"

// Sluituur: laatste chart-candle voor exitHour (die sluit om exitHour, de
// sluit-order vult op die close).
exitToday = timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), exitHour, 0)
exitBar   = useExitHour and time < exitToday and time_close >= exitToday

// Positiegrootte in units bij een gegeven R (prijsafstand entry -> SL).
f_tradeQty(float r) =>
    perUnit = r * syminfo.pointvalue * quoteToUsd + commPerLot / contractSize
    base    = sizeMode == "Risico % van vast saldo" ? fixedBalance : strategy.equity
    float raw = sizeMode == "Vaste lotgrootte" ? fixedLots * contractSize : perUnit > 0 ? base * riskPct / 100 / perUnit : na
    na(raw) ? na : math.max(math.floor(raw / qtyStep + 1e-9) * qtyStep, qtyStep)

// Entry/SL/TP-lijn + label voor een trade, van de signaal-candle tot endT.
f_tradeLine(int startT, int endT, float price, color col, string txt) =>
    line.new(startT, price, endT, price, xloc.bar_time, extend.none, col, line.style_dashed, 2)
    if showTradeLabels
        label.new(endT, price, txt, xloc.bar_time, yloc.price, color.new(col, 80), label.style_label_left, col, size.small)

// Laatst gesloten 30m-candle van de rekenfeed, voor de flip-check. Zelfde
// barstate.isconfirmed-aanpak als f_calc30m: nooit een lopende 30m-candle.
f_bar30() =>
    var float o = na
    var float h = na
    var float l = na
    var float c = na
    var int   t = na
    if barstate.isconfirmed
        o := open
        h := high
        l := low
        c := close
        t := time
    [o, h, l, c, t]

[f30Open, f30High, f30Low, f30Close, f30Time] = request.security(calcTicker, calcTF, f_bar30(), lookahead=barmerge.lookahead_off)

// Plaatst entry + SL/TP-exit en tekent de lijnen. stopPx = na -> market op
// de close, anders een stop-order op stopPx. qtyR = afstand waarop de
// positiegrootte berekend wordt. Retourneert de positiegrootte (0 = niet geplaatst).
f_placeTrade(int d, int startT, float entry, float sl, float tp, float r, float qtyR, float stopPx) =>
    id  = d == 1 ? "Long" : "Short"
    qty = qtyR > 0 ? nz(f_tradeQty(qtyR)) : 0.0
    if qty > 0
        strategy.entry(id, d == 1 ? strategy.long : strategy.short, qty = qty, stop = stopPx, comment = id + " R " + str.tostring(r, format.mintick))
        strategy.exit(id + " exit", id, stop = sl, limit = tp, comment_loss = "SL", comment_profit = "TP")
        if showTradeLines
            endT = startT + lineLen * barMs
            f_tradeLine(startT, endT, entry, color.blue, id + (na(stopPx) ? " entry" : " stop-entry") + srcTag + ": " + str.tostring(entry, format.mintick) + " · " + str.tostring(qty / contractSize, "0.00") + " lot · R " + str.tostring(r, format.mintick))
            f_tradeLine(startT, endT, sl, d == 1 ? color.green : color.red, "SL" + srcTag + ": " + str.tostring(sl, format.mintick))
            f_tradeLine(startT, endT, tp, color.blue, "TP" + srcTag + " (" + str.tostring(tpRR, "#.##") + " R/R): " + str.tostring(tp, format.mintick))
    qty

var int   lastHandledBreak = na
var int   posDir           = 0
var int   posBreakTime     = na
var float posSL            = na
var float posTP            = na
var float posR             = na
var int   posEntryBar      = na
var bool  beDone           = false

// Signaal dat wacht op de flip-candle.
var int   pendDir   = 0
var int   pendBreak = na
var float pendEntry = na
var float pendSL    = na
var float pendTP    = na
var float pendR     = na

// Openstaande stop-order (entry op break-prijs na de flip).
var bool  ordActive = false
var int   ordExpiry = na

var int lastF30 = na
newF30 = isSupportedTF and not na(f30Time) and (na(lastF30) or f30Time != lastF30)
if newF30
    lastF30 := f30Time

// --- 1. Openstaande stop-order: gevuld, of annuleren (SL eerst geraakt,
// verlopen, sluituur). ---
if ordActive
    filled = posDir == 1 ? strategy.position_size > 0 : strategy.position_size < 0
    if filled
        ordActive   := false
        posEntryBar := bar_index
    else
        slTouched = posDir == 1 ? low <= posSL : high >= posSL
        if slTouched or exitBar or time_close >= ordExpiry
            strategy.cancel(posDir == 1 ? "Long" : "Short")
            ordActive := false

// --- 2. Flip-check op de eerste gesloten 30m-candle na de breakout-candle.
// Niet gehaald = trade niet mogelijk = genegeerd (geen label). ---
if pendDir != 0 and newF30 and f30Time > pendBreak
    d       = pendDir
    body    = (f30Close - f30Open) * d
    flipOk  = body < 0 and -body >= flipMinRR * pendR
    pull    = d == 1 ? pendEntry - (flipPullMode == "Wick" ? f30Low : f30Close) : (flipPullMode == "Wick" ? f30High : f30Close) - pendEntry
    tooDeep = pull > flipMaxRR * pendR
    busy    = ignoreInPos and strategy.position_size != 0
    atBreak = flipEntryMode == "Op break-prijs (stop-order)"
    if flipOk and not tooDeep and not busy and not exitBar and inWindow
        // Market: positiegrootte op de werkelijke afstand close -> SL.
        qtyR = atBreak ? pendR : (close - pendSL) * d
        qty  = f_placeTrade(d, f30Time, atBreak ? pendEntry : close, pendSL, pendTP, pendR, qtyR, atBreak ? pendEntry : na)
        if qty > 0
            posDir       := d
            posBreakTime := pendBreak
            posSL        := pendSL
            posTP        := pendTP
            posR         := pendR
            beDone       := false
            if atBreak
                ordActive   := true
                ordExpiry   := f30Time + (flipOrderBars + 1) * barMs
                posEntryBar := na
            else
                posEntryBar := bar_index
    pendDir := 0

// --- 3. Nieuw signaal: calcBreakTime verandert alleen bij een nieuwe break
// en komt precies 1x binnen, ook op de 15m-chart. ---
newBreak = isSupportedTF and not na(calcBreakTime) and (na(lastHandledBreak) or calcBreakTime != lastHandledBreak)

if newBreak
    lastHandledBreak := calcBreakTime
    isLong = calcBreakSide
    d      = isLong ? 1 : -1
    ok     = isLong ? calcLongTradeOk : calcShortTradeOk
    entry  = isLong ? calcLongEntry : calcShortEntry
    r      = isLong ? calcLongR : calcShortR
    tp     = isLong ? calcLongTP : calcShortTP
    sl     = entry - d * r
    dirOk  = isLong ? allowLong : allowShort
    busy   = ignoreInPos and strategy.position_size != 0
    id     = isLong ? "Long" : "Short"

    // Een nieuw signaal vervangt een nog niet gevulde stop-order.
    if ordActive
        strategy.cancel(posDir == 1 ? "Long" : "Short")
        ordActive := false

    if ok and dirOk and inWindow and not busy and not exitBar
        if flipOn
            pendDir   := d
            pendBreak := calcBreakTime
            pendEntry := entry
            pendSL    := sl
            pendTP    := tp
            pendR     := r
        else
            qty = f_placeTrade(d, calcBreakTime, entry, sl, tp, r, r, na)
            if qty > 0
                posDir       := d
                posBreakTime := calcBreakTime
                posSL        := sl
                posTP        := tp
                posR         := r
                posEntryBar  := bar_index
                beDone       := false
    else if ok and showNoTrade and inWindow
        string reason = not dirOk ? "richting staat uit" : busy ? "positie al open" : "sluituur"
        label.new(calcBreakTime, isLong ? calcLongBreakLevel : calcShortBreakLevel, id + " geen trade" + srcTag + "\n" + reason, xloc.bar_time, yloc.price, color.new(color.orange, 20), isLong ? label.style_label_up : label.style_label_down, color.black, size.small)

// Trailing SL: binnen het signaalvenster van de eigen trade, alleen als de
// nieuwe SL dichter bij de prijs ligt dan de huidige.
if trailSL and strategy.position_size != 0 and posDir != 0 and calcBreakTime == posBreakTime
    newSL      = posDir == 1 ? calcLongTrailSL : calcShortTrailSL
    sideActive = posDir == 1 ? (calcLongActive and calcSlSide) : (calcShortActive and not calcSlSide)
    if sideActive and not na(newSL) and (posDir == 1 ? newSL > posSL : newSL < posSL)
        posSL := newSL
        tid = posDir == 1 ? "Long" : "Short"
        strategy.exit(tid + " exit", tid, stop = posSL, limit = posTP, comment_loss = "SL trail", comment_profit = "TP")

// Break-even: raakt de high (Long) / low (Short) +beTrigger R vanaf de fill,
// dan gaat de SL naar fill + beLevel R. Eenmalig per trade, en alleen als de
// SL daardoor verbetert (een strakkere trailing SL blijft staan).
if beOn and not beDone and strategy.position_size != 0 and posDir != 0 and not na(posR) and bar_index > posEntryBar
    fill = strategy.position_avg_price
    hit  = posDir == 1 ? high >= fill + beTrigger * posR : low <= fill - beTrigger * posR
    if hit
        beDone := true
        beSL = fill + posDir * beLevel * posR
        if posDir == 1 ? beSL > posSL : beSL < posSL
            posSL := beSL
            bid = posDir == 1 ? "Long" : "Short"
            strategy.exit(bid + " exit", bid, stop = posSL, limit = posTP, comment_loss = "BE", comment_profit = "TP")
            if showTradeLines
                f_tradeLine(time, time + lineLen * barMs, posSL, color.orange, "SL -> " + str.tostring(beLevel, "#.##") + "R: " + str.tostring(posSL, format.mintick))

// Tijd-exits.
if strategy.position_size != 0
    if maxHoldBars > 0 and not na(posBreakTime) and time_close >= posBreakTime + (maxHoldBars + 1) * barMs
        strategy.close_all(comment = str.tostring(maxHoldBars) + " candles")
    else if exitBar
        strategy.close_all(comment = str.tostring(exitHour) + ":00")
    else if time > endDate
        strategy.close_all(comment = "Einde backtest")

// ============================================================
// Actuele Resistance / Support / Target-lijnen (alleen de laatste stand,
// zoals in de indicator).
// ============================================================
f_nameText(string name, bool fallback, int barsBack) =>
    name + srcTag + (fallback ? " [FALLBACK]" : " [pivot " + str.tostring(barsBack) + " candles terug]")

var line  rLine       = na
var line  sLine       = na
var line  trLine      = na
var line  tsLine      = na
var label rNameLabel  = na
var label sNameLabel  = na
var label trNameLabel = na
var label tsNameLabel = na

if showSR and isSupportedTF and barstate.islast and not na(calcResistance)
    line.delete(rLine)
    line.delete(sLine)
    line.delete(trLine)
    line.delete(tsLine)
    label.delete(rNameLabel)
    label.delete(sNameLabel)
    label.delete(trNameLabel)
    label.delete(tsNameLabel)

    rLine  := line.new(calcRPivotTime, calcResistance, calcBarTime, calcResistance, xloc.bar_time, extend.right, color.new(color.red, 0), line.style_solid, 2)
    sLine  := line.new(calcSPivotTime, calcSupport, calcBarTime, calcSupport, xloc.bar_time, extend.right, color.new(color.green, 0), line.style_solid, 2)
    trLine := line.new(calcTrPivotTime, calcTargetResistance, calcBarTime, calcTargetResistance, xloc.bar_time, extend.right, color.new(color.red, 40), line.style_solid, 2)
    tsLine := line.new(calcTsPivotTime, calcTargetSupport, calcBarTime, calcTargetSupport, xloc.bar_time, extend.right, color.new(color.green, 40), line.style_solid, 2)

    rNameLabel  := label.new(calcBarTime, calcResistance, f_nameText("Resistance", calcRFallback, calcRBarsBack), xloc.bar_time, yloc.price, color.new(color.red, 100), label.style_label_left, labelTextColor, size.small)
    sNameLabel  := label.new(calcBarTime, calcSupport, f_nameText("Support", calcSFallback, calcSBarsBack), xloc.bar_time, yloc.price, color.new(color.green, 100), label.style_label_left, labelTextColor, size.small)
    trNameLabel := label.new(calcBarTime, calcTargetResistance, f_nameText("Target Resistance", calcTrFallback, calcTrBarsBack), xloc.bar_time, yloc.price, color.new(color.red, 100), label.style_label_left, labelTextColor, size.small)
    tsNameLabel := label.new(calcBarTime, calcTargetSupport, f_nameText("Target Support", calcTsFallback, calcTsBarsBack), xloc.bar_time, yloc.price, color.new(color.green, 100), label.style_label_left, labelTextColor, size.small)
