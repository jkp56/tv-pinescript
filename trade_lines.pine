//@version=6
// Versie: 1.9.25 - zie CHANGELOG.md voor de wijzigingsgeschiedenis.
//
// NIEUW IN 1.9.0: alle berekeningen (Support/Resistance, Targets, LONG/SHORT
// signalen, SL, TP + Range-check) draaien nu ALTIJD op het 30-minuten
// timeframe, ongeacht op welk timeframe de chart zelf staat. Dit gebeurt via
// request.security(). De lijnen/labels worden getekend met tijd-gebaseerde
// coördinaten (xloc.bar_time i.p.v. xloc.bar_index), zodat ze exact
// hetzelfde prijsniveau tonen op zowel de 30m- als de 15m-chart. De
// indicator ondersteunt uitsluitend deze twee timeframes; op elk ander
// timeframe verschijnt een waarschuwingslabel en wordt er niets getekend.
//
// Belangrijk gevolg van deze aanpak: de lijnen/labels worden bijgewerkt op
// het moment dat een 30-minuten candle sluit - ook als je op dat moment de
// 15m-chart aan het bekijken bent. Ze "springen" dus niet pas bij het
// terugschakelen naar 30m; ze volgen de 30m-klok, niet de 15m-klok.
indicator("Trade Lijnen (SL/S/R)", overlay=true, max_lines_count=30, max_labels_count=30)

// ============================================================
// VERSIE-INFO: bovenaan geplaatst zodat de huidige versie direct
// zichtbaar is in het Inputs-tabblad van de instellingen, zonder in de
// code te hoeven kijken. Zie CHANGELOG.md voor de wijzigingsgeschiedenis.
// ============================================================
scriptVersion = input.string("1.9.25", "Versie", options=["1.9.25"], group="Info")

// ============================================================
// FREEZE-TOGGLE: direct onder de versie-info geplaatst (eigen groep, los
// van "Trade Mogelijkheid") zodat deze zonder scrollen bovenaan het
// Inputs-tabblad van de instellingen staat.
// ============================================================
freezeOnValidTrade = input.bool(false, "Lijnen bevriezen zodra een geldige trade ontstaat (handmatig uit/aan = reset)", group="Freeze")

// Vast timeframe waarop alle berekeningen draaien. De indicator ondersteunt
// alleen dit timeframe en het kortere "15" timeframe waarop de lijnen van
// dit timeframe blijven getoond.
calcTF        = "30"
lowerTF       = "15"
isSupportedTF = timeframe.period == calcTF or timeframe.period == lowerTF

// ============================================================
// STOP LOSS LIJNEN
// - Long SL = low van laatst gesloten 30m-candle min x ticks (wick telt mee)
// - Short SL = high van laatst gesloten 30m-candle plus x ticks (wick telt mee)
// - Slechts 1 lijn tegelijk zichtbaar: Long SL alleen bij een bullish
//   30m-candle, Short SL alleen bij een bearish 30m-candle. Bij het tekenen
//   van de ene lijn wordt de andere verwijderd.
// - Bij een doji (close == open) wordt geen van beide bijgewerkt: normaal
//   wordt bij een doji geen trade genomen, dus blijft de SL op zijn laatst
//   geldige niveau staan (tenzij het signaalvenster hieronder intussen
//   verloopt).
// - De SL-lijn wordt alleen daadwerkelijk getoond als, naast bovenstaande
//   voorwaarden, de candle ook binnen het "signaalvenster" valt: er moet een
//   LONG-signaal (voor Long SL) resp. SHORT-signaal (voor Short SL) zijn
//   geweest binnen de laatste `slSignalWindow` 30m-candles (de signaal-
//   candle zelf telt als candle 1 van het venster).
// ============================================================
showSL         = input.bool(true, "Toon SL lijnen", group="Stop Loss lijnen")
trailSL        = input.bool(false, "SL: trailing (bijwerken bij elke nieuwe candle in het venster)", group="Stop Loss lijnen")
tickOffset     = input.int(50, "SL: aantal ticks van wick", minval=1, group="Stop Loss lijnen")
lineLen        = input.int(20, "SL: lengte lijn (aantal 30m-candles naar rechts)", minval=1, group="Stop Loss lijnen")
slSignalWindow = input.int(2, "SL: lijn actief na signaal (aantal 30m-candles)", minval=1, group="Stop Loss lijnen")
longColor      = input.color(color.new(color.green, 0), "Kleur Long SL", group="Stop Loss lijnen")
shortColor     = input.color(color.new(color.red, 0), "Kleur Short SL", group="Stop Loss lijnen")

// ============================================================
// RESISTANCE / SUPPORT (volledig automatisch, altijd op 30m-candles)
// Zie oorspronkelijke documentatie/CHANGELOG voor de volledige detectie-
// logica (bullish->bearish resp. bearish->bullish overgang op body-niveau,
// wick-gratieperiode voor de Target-lijnen, enz.) - deze logica zelf is
// ongewijzigd t.o.v. v1.8.2, alleen de context waarin hij draait (altijd
// 30m) en de manier van tekenen (tijd-gebaseerd) zijn aangepast.
// ============================================================
maxScanBars      = input.int(450, "Max bars terugzoeken", minval=10, maxval=500, group="Support / Resistance")
autoTargetTicks  = input.int(100, "Fallback afstand target lijnen (ticks, alleen als geen geldige overgang gevonden wordt)", minval=1, group="Support / Resistance")
minTargetDistance = input.int(300, "Minimale afstand Target t.o.v. Resistance/Support (ticks)", minval=1, group="Support / Resistance")
labelTextColor   = input.color(color.black, "Labelkleur (tekst)", group="Support / Resistance")
excludeReversalCandle = input.bool(true, "Support/Resistance: reversal-candle uitsluiten van eigen invalidatie", group="Support / Resistance")
debugSupportPivot = input.bool(false, "Debug: toon eerste Support-kandidaat + reden verwerping (alleen op 30m-chart)", group="Support / Resistance")
debugCalcPanel = input.bool(false, "Debug: toon diagnosepaneel (calc*/newData-waarden)", group="Support / Resistance")

// ============================================================
// SIGNAAL INSTELLINGEN
// ============================================================
xTicks  = input.int(10, "X: aantal ticks voorbij S/R voor signaal", minval=1, group="Signaal instellingen")

// ============================================================
// TRADE MOGELIJKHEID: TP (bij ingestelde R/R) + Range-check
// - R = verschil tussen de close van de signaal-candle en de waarde van de
//   SL-lijn bij dat signaal (zelfde formule als de Long/Short SL):
//     Long:  SL = low  van de signaal-candle - x ticks  ->  R = close - SL
//     Short: SL = high van de signaal-candle + x ticks  ->  R = SL - close
// - TP = entry (= close van de signaal-candle) +/- tpRR * R.
// - Range = vrije ruimte voor de trade: afstand tussen entry en Target
//   Resistance (Long), resp. tussen entry en Target Support (Short) - het
//   Target zoals het op de chart stond op het moment van de break (de
//   PRE-update waarde, net als de doorbroken Resistance/Support zelf), dus
//   niet zoals het op de signaal-candle of daarna opnieuw getekend wordt.
//   Bewust NIET gemeten
//   vanaf het (verschoven) Resistance/Support-level: dat kan vlak bij het
//   Target liggen, waardoor de Range kunstmatig klein wordt terwijl de
//   trade zelf ruim baan heeft.
// - Trade alleen mogelijk als die Range minimaal minRangeRR * R kan bevatten
//   EN R (in ticks) niet groter is dan maxRTicks. Zo niet: geen TP-lijn,
//   maar een "Trade niet mogelijk"-label met de reden(en).
// ============================================================
showTradeCheck = input.bool(true, "Toon TP-lijn en Trade-mogelijkheid check", group="Trade Mogelijkheid")
tpRR           = input.float(1.2, "TP: Risk/Reward ratio", minval=0.01, step=0.1, group="Trade Mogelijkheid")
minRangeRR     = input.float(1.0, "Minimaal benodigde R/R-ruimte in de Range", minval=0.01, step=0.1, group="Trade Mogelijkheid")
maxRTicks      = input.int(1000, "Maximaal toegestane R (ticks)", minval=1, group="Trade Mogelijkheid")
tpColor        = input.color(color.new(color.blue, 0), "Kleur TP-lijn", group="Trade Mogelijkheid")
noTradeColor   = input.color(color.new(color.orange, 0), "Kleur 'Trade niet mogelijk'-label", group="Trade Mogelijkheid")

tickSize = syminfo.mintick
slOffset = tickOffset * tickSize
xOffset  = xTicks * tickSize

// Range uitgedrukt in R, naar beneden afgerond op 2 decimalen: zo toont een
// net-niet-gehaalde check (bijv. 0.997R) nooit misleidend "1R < 1R".
f_fmtRR(float x) =>
    na(x) ? "-" : str.tostring(math.floor(x * 100) / 100, "0.00")

max_bars_back(open, 500)
max_bars_back(close, 500)
max_bars_back(high, 500)
max_bars_back(low, 500)
max_bars_back(time, 500)

// ============================================================
// PURE HELPER FUNCTIES (ongewijzigde detectielogica t.o.v. v1.8.2).
// Deze functies geven nu een OFFSET ("aantal candles terug") terug i.p.v.
// een absolute bar_index, zodat we er zowel de tekst ("X candles terug")
// als de exacte tijd (via time[offset]) uit kunnen afleiden - nodig om de
// lijnen straks tijd-gebaseerd te kunnen tekenen.
// ============================================================
f_bodyTop(i) => math.max(open[i], close[i])
f_bodyBottom(i) => math.min(open[i], close[i])
f_validBar(i) => open[i] > 0 and close[i] > 0 and high[i] > 0 and low[i] > 0

f_safeHighest(length) =>
    float m = na
    for i = 0 to length - 1
        if f_validBar(i)
            m := na(m) ? high[i] : math.max(m, high[i])
    m

f_safeLowest(length) =>
    float m = na
    for i = 0 to length - 1
        if f_validBar(i)
            m := na(m) ? low[i] : math.min(m, low[i])
    m

// Generiek voor zowel Resistance/Support als de Target-lijnen: alleen de
// allereerste candle na de bearish/bullish-overgang mag het level met een
// wick raken (gratie). Elke candle daarna - ongeacht kleur - maakt het level
// ongeldig ("uitgenomen") zodra de wick het raakt.
f_wickValidAboveLevel(pivotOffset, level) =>
    bool valid = true
    bool graceActive = true
    for k = pivotOffset - 1 to 0
        if f_validBar(k)
            if graceActive
                graceActive := false
            else if high[k] >= level
                valid := false
                break
    valid

f_wickValidBelowLevel(pivotOffset, level) =>
    bool valid = true
    bool graceActive = true
    for k = pivotOffset - 1 to 0
        if f_validBar(k)
            if graceActive
                graceActive := false
            else if low[k] <= level
                valid := false
                break
    valid

// Resistance: bullish -> bearish overgang, body-top. Eerste geldige
// (bodyValid) pivot-level, ongeacht wicks - dit is puur de dichtstbijzijnde
// aanzet; of dit level uiteindelijk het getoonde Resistance-level blijft of
// verschuift naar een tussenliggend level hangt af van de Target-zoektocht
// verderop (zie f_autoTargetResistance). Retourneert [level, barsBack].
f_autoResistance(maxScan, excludeReversal) =>
    float level = na
    int barsBack = na
    float runningMaxTop = na
    for i = 0 to maxScan - 2
        if not excludeReversal and f_validBar(i)
            runningMaxTop := na(runningMaxTop) ? f_bodyTop(i) : math.max(runningMaxTop, f_bodyTop(i))
        if f_validBar(i) and f_validBar(i + 1) and close[i + 1] > open[i + 1] and close[i] < open[i]
            candidate = f_bodyTop(i + 1)
            if na(runningMaxTop) or runningMaxTop <= candidate
                level := candidate
                barsBack := i + 1
                break
        if excludeReversal and f_validBar(i)
            runningMaxTop := na(runningMaxTop) ? f_bodyTop(i) : math.max(runningMaxTop, f_bodyTop(i))
    [level, barsBack]

// Support: spiegelbeeld van Resistance. Retourneert [level, barsBack].
f_autoSupport(maxScan, excludeReversal) =>
    float level = na
    int barsBack = na
    float runningMinBottom = na
    for i = 0 to maxScan - 2
        if not excludeReversal and f_validBar(i)
            runningMinBottom := na(runningMinBottom) ? f_bodyBottom(i) : math.min(runningMinBottom, f_bodyBottom(i))
        if f_validBar(i) and f_validBar(i + 1) and close[i + 1] < open[i + 1] and close[i] > open[i]
            candidate = f_bodyBottom(i + 1)
            if na(runningMinBottom) or runningMinBottom >= candidate
                level := candidate
                barsBack := i + 1
                break
        if excludeReversal and f_validBar(i)
            runningMinBottom := na(runningMinBottom) ? f_bodyBottom(i) : math.min(runningMinBottom, f_bodyBottom(i))
    [level, barsBack]

// DEBUG (alleen gebruikt op de native 30m-chart, buiten request.security om -
// blijft bar_index-gebaseerd, precies zoals in v1.8.2).
f_debugFirstSupportCandidate(maxScan, excludeReversal) =>
    float level = na
    int pivotBar = na
    int rejectBar = na
    float rejectLevel = na
    float runningMinBottom = na
    bool found = false
    for i = 0 to maxScan - 2
        if not found
            if not excludeReversal and f_validBar(i)
                runningMinBottom := na(runningMinBottom) ? f_bodyBottom(i) : math.min(runningMinBottom, f_bodyBottom(i))
            if f_validBar(i) and f_validBar(i + 1) and close[i + 1] < open[i + 1] and close[i] > open[i]
                candidate = f_bodyBottom(i + 1)
                level := candidate
                pivotBar := bar_index - (i + 1)
                found := true
                if not (na(runningMinBottom) or runningMinBottom >= candidate)
                    for k = 0 to i - 1
                        if f_validBar(k) and f_bodyBottom(k) < candidate
                            rejectBar := bar_index - k
                            rejectLevel := f_bodyBottom(k)
                            break
            if excludeReversal and f_validBar(i)
                runningMinBottom := na(runningMinBottom) ? f_bodyBottom(i) : math.min(runningMinBottom, f_bodyBottom(i))
    [level, pivotBar, rejectBar, rejectLevel]

// Target Resistance: EIGEN zoektocht. Zoekt het EERSTE bodyValid pivot-level
// dat ZOWEL ver genoeg (minDistance) van Resistance ligt ALS wick-valid is -
// dat wordt het Target, en de zoektocht stopt daar. Onderweg wordt ook het
// LAATSTE bodyValid level bijgehouden dat niet aan beide eisen voldeed (dus
// te dichtbij lag, of al eerder met een wick geraakt is) - dat is het level
// waar Resistance eventueel naar verschuift. Resistance vereist zelf GEEN
// wick-validiteit (net als f_autoResistance) - alleen de Target-lijn zelf
// moet nog "schoon" (ongeraakt) zijn (zie f_calc30m: shift gebeurt alleen als
// er een Target gevonden is EN er zo'n tussenliggend level bestaat; anders
// blijven Resistance en Target zoals ze zijn). Retourneert
// [level, barsBack, shiftLevel, shiftBarsBack].
f_autoTargetResistance(maxScan, resistanceLevel, minDistance, excludeReversal) =>
    float level = na
    int barsBack = na
    float shiftLevel = na
    int shiftBarsBack = na
    float runningMaxBodyTop = na
    for i = 0 to maxScan - 2
        if not excludeReversal and f_validBar(i)
            runningMaxBodyTop := na(runningMaxBodyTop) ? f_bodyTop(i) : math.max(runningMaxBodyTop, f_bodyTop(i))
        if f_validBar(i) and f_validBar(i + 1) and close[i + 1] > open[i + 1] and close[i] < open[i]
            candidate = f_bodyTop(i + 1)
            bodyValid = na(runningMaxBodyTop) or runningMaxBodyTop <= candidate
            if bodyValid
                if (candidate - resistanceLevel) >= minDistance and f_wickValidAboveLevel(i + 1, candidate)
                    level := candidate
                    barsBack := i + 1
                    break
                else
                    shiftLevel := candidate
                    shiftBarsBack := i + 1
        if excludeReversal and f_validBar(i)
            runningMaxBodyTop := na(runningMaxBodyTop) ? f_bodyTop(i) : math.max(runningMaxBodyTop, f_bodyTop(i))
    [level, barsBack, shiftLevel, shiftBarsBack]

// Target Support: spiegelbeeld van f_autoTargetResistance. Support vereist
// zelf GEEN wick-validiteit (net als f_autoSupport) - alleen de Target-lijn
// zelf moet nog "schoon" zijn. Retourneert [level, barsBack, shiftLevel, shiftBarsBack].
f_autoTargetSupport(maxScan, supportLevel, minDistance, excludeReversal) =>
    float level = na
    int barsBack = na
    float shiftLevel = na
    int shiftBarsBack = na
    float runningMinBodyBottom = na
    for i = 0 to maxScan - 2
        if not excludeReversal and f_validBar(i)
            runningMinBodyBottom := na(runningMinBodyBottom) ? f_bodyBottom(i) : math.min(runningMinBodyBottom, f_bodyBottom(i))
        if f_validBar(i) and f_validBar(i + 1) and close[i + 1] < open[i + 1] and close[i] > open[i]
            candidate = f_bodyBottom(i + 1)
            bodyValid = na(runningMinBodyBottom) or runningMinBodyBottom >= candidate
            if bodyValid
                if (supportLevel - candidate) >= minDistance and f_wickValidBelowLevel(i + 1, candidate)
                    level := candidate
                    barsBack := i + 1
                    break
                else
                    shiftLevel := candidate
                    shiftBarsBack := i + 1
        if excludeReversal and f_validBar(i)
            runningMinBodyBottom := na(runningMinBodyBottom) ? f_bodyBottom(i) : math.min(runningMinBodyBottom, f_bodyBottom(i))
    [level, barsBack, shiftLevel, shiftBarsBack]

// ============================================================
// ALLE BEREKENINGEN: draait via request.security() altijd op het 30m-
// timeframe, ook als de chart zelf op 15m staat. De "var" + barstate.
// isconfirmed-combinatie zorgt ervoor dat er nooit in een nog lopende
// (niet-afgesloten) 30m-candle gekeken wordt (geen repainting): zolang die
// candle nog loopt, blijven alle velden gewoon op hun laatst bevestigde
// waarde staan.
// ============================================================
f_calc30m() =>
    var float resistance       = na
    var float support          = na
    var float targetResistance = na
    var float targetSupport    = na
    var float prevResistance   = na
    var float prevSupport      = na
    var float prevTargetResistance = na
    var float prevTargetSupport    = na
    var rFallback  = bool(na)
    var sFallback  = bool(na)
    var trFallback = bool(na)
    var tsFallback = bool(na)
    var int   rPivotTime  = na
    var int   sPivotTime  = na
    var int   trPivotTime = na
    var int   tsPivotTime = na
    var int   rBarsBack   = na
    var int   sBarsBack   = na
    var int   trBarsBack  = na
    var int   tsBarsBack  = na

    var int barTime       = na
    var int rightEdgeTime = na

    var bool longActive   = false
    var bool shortActive  = false
    var int  lastLongBar  = na
    var int  lastShortBar = na

    var float longTrailSL  = na
    var float shortTrailSL = na
    var slSide             = bool(na)

    var float longBreakLevel  = na
    var float shortBreakLevel = na
    var int   breakTime       = na
    var breakSide             = bool(na)
    var float breakLow        = na
    var float breakHigh       = na

    var bool   longTradeOk    = false
    var float  longTP         = na
    var string longReasonText = ""
    var float  longRangeRR    = na
    var float  longEntry      = na
    var float  longR          = na

    var bool   shortTradeOk    = false
    var float  shortTP         = na
    var string shortReasonText = ""
    var float  shortRangeRR    = na
    var float  shortEntry      = na
    var float  shortR          = na

    if barstate.isconfirmed
        barTime       := time
        rightEdgeTime := time + lineLen * timeframe.in_seconds(calcTF) * 1000

        // --- Resistance / Support / Targets ---
        prevResistance := resistance
        prevSupport    := support
        prevTargetResistance := targetResistance
        prevTargetSupport    := targetSupport

        [rawResistance, rBack] = f_autoResistance(maxScanBars, excludeReversalCandle)
        [rawSupport, sBack]    = f_autoSupport(maxScanBars, excludeReversalCandle)

        resistance := na(rawResistance) ? f_safeHighest(maxScanBars) : rawResistance
        support    := na(rawSupport) ? f_safeLowest(maxScanBars) : rawSupport
        rFallback  := na(rawResistance)
        sFallback  := na(rawSupport)
        rBarsBack  := na(rawResistance) ? maxScanBars : rBack
        sBarsBack  := na(rawSupport) ? maxScanBars : sBack

        [rawTargetResistance, trBack, rShiftLevel, rShiftBarsBack] = f_autoTargetResistance(maxScanBars, resistance, minTargetDistance * tickSize, excludeReversalCandle)
        [rawTargetSupport, tsBack, sShiftLevel, sShiftBarsBack]    = f_autoTargetSupport(maxScanBars, support, minTargetDistance * tickSize, excludeReversalCandle)

        // Resistance/Support verschuiven naar het laatste geldige tussenliggende
        // level vóór het gevonden Target - maar alleen als er ook daadwerkelijk
        // een Target gevonden is én er zo'n tussenliggend level bestaat. Is dat
        // niet het geval, dan blijven Resistance/Support en Target ongewijzigd.
        if not na(rawTargetResistance) and not na(rShiftLevel)
            resistance := rShiftLevel
            rBarsBack  := rShiftBarsBack
        if not na(rawTargetSupport) and not na(sShiftLevel)
            support    := sShiftLevel
            sBarsBack  := sShiftBarsBack

        rPivotTime := time[rBarsBack]
        sPivotTime := time[sBarsBack]

        fallbackTicks = math.max(autoTargetTicks, minTargetDistance)
        targetResistance := na(rawTargetResistance) ? resistance + fallbackTicks * tickSize : rawTargetResistance
        targetSupport    := na(rawTargetSupport) ? support - fallbackTicks * tickSize : rawTargetSupport
        trFallback := na(rawTargetResistance)
        tsFallback := na(rawTargetSupport)
        trBarsBack := na(rawTargetResistance) ? maxScanBars : trBack
        tsBarsBack := na(rawTargetSupport) ? maxScanBars : tsBack
        trPivotTime := time[trBarsBack]
        tsPivotTime := time[tsBarsBack]

        // --- Breakout-signalen (tegen de PRE-update Resistance/Support) ---
        bullishLevel = prevResistance + xOffset
        bearishLevel = prevSupport - xOffset

        // Was er al een actief signaal in dezelfde richting (op basis van de
        // ORIGINELE lastLongBar/lastShortBar, dus vóór de eventuele update
        // hieronder)? Zo ja, dan mag dit geen nieuwe break tellen: Support/
        // Resistance kan van candle op candle flink verspringen (het dichtst-
        // bijzijnde nog-niet-gebroken level verandert na een sterke beweging),
        // waardoor prevSupport/prevResistance - en dus bullishLevel/bearish-
        // Level - kan verschuiven zonder dat de markt echt opnieuw een level
        // doorbreekt. Zonder deze check vuurt zo'n verschuiving een tweede
        // (spurious) breakout af met een compleet andere, vaak veel grotere R,
        // puur omdat de drempel zelf is bijgesteld.
        wasLongActive  = not na(lastLongBar) and (bar_index - lastLongBar) < slSignalWindow
        wasShortActive = not na(lastShortBar) and (bar_index - lastShortBar) < slSignalWindow

        bullishBreakNow = not na(prevResistance) and close > bullishLevel and close[1] <= bullishLevel and not wasLongActive
        bearishBreakNow = not na(prevSupport) and close < bearishLevel and close[1] >= bearishLevel and not wasShortActive

        if bullishBreakNow
            lastLongBar    := bar_index
            breakSide      := true
            breakTime      := time
            longBreakLevel := bullishLevel
            breakLow       := low

        if bearishBreakNow
            lastShortBar    := bar_index
            breakSide        := false
            breakTime         := time
            shortBreakLevel  := bearishLevel
            breakHigh         := high

        longActive  := not na(lastLongBar) and (bar_index - lastLongBar) < slSignalWindow
        shortActive := not na(lastShortBar) and (bar_index - lastShortBar) < slSignalWindow

        // --- SL-weergave: op de signaal-candle zelf wordt de SL altijd gezet.
        // Staat trailSL aan, dan werkt elke volgende candle van de "juiste"
        // kleur binnen het venster de getoonde SL nog bij; staat trailSL uit
        // (default), dan blijft de SL vanaf de signaal-candle vast staan -
        // net als de TP-lijn (los van de vaste R hieronder). ---
        isBull = close > open
        isBear = close < open
        if isBull and longActive and (trailSL or bar_index == lastLongBar)
            longTrailSL := low - slOffset
            slSide      := true
        if isBear and shortActive and (trailSL or bar_index == lastShortBar)
            shortTrailSL := high + slOffset
            slSide       := false

        // --- Trade Mogelijkheid: TP + Range-check, vast bepaald op de
        // signaal-candle zelf, blijft ongewijzigd zolang het venster loopt ---
        if bullishBreakNow and not na(prevTargetResistance)
            slAtSignal  = low - slOffset
            entryPrice  = close
            rValue      = entryPrice - slAtSignal
            rTicks      = rValue / tickSize
            tpValue     = entryPrice + tpRR * rValue
            rangeAvail  = prevTargetResistance - entryPrice
            rangeNeeded = minRangeRR * rValue
            rangeOk     = rangeAvail >= rangeNeeded
            rTooLarge   = rTicks > maxRTicks

            longTP      := tpValue
            longRangeRR := rValue > 0 ? rangeAvail / rValue : na
            longEntry   := entryPrice
            longR       := rValue
            longTradeOk := rValue > 0 and rangeOk and not rTooLarge

            string reasonText = ""
            if not rangeOk
                reasonText := reasonText + "Range " + f_fmtRR(rangeAvail / rValue) + "R < " + str.tostring(minRangeRR, "#.##") + "R (" + str.tostring(rangeAvail, format.mintick) + " < " + str.tostring(rangeNeeded, format.mintick) + ")"
            if rTooLarge
                if reasonText != ""
                    reasonText := reasonText + "\n"
                reasonText := reasonText + "R " + str.tostring(rTicks, "#.##") + " ticks > max " + str.tostring(maxRTicks) + " ticks"
            longReasonText := reasonText

        if bearishBreakNow and not na(prevTargetSupport)
            slAtSignal  = high + slOffset
            entryPrice  = close
            rValue      = slAtSignal - entryPrice
            rTicks      = rValue / tickSize
            tpValue     = entryPrice - tpRR * rValue
            rangeAvail  = entryPrice - prevTargetSupport
            rangeNeeded = minRangeRR * rValue
            rangeOk     = rangeAvail >= rangeNeeded
            rTooLarge   = rTicks > maxRTicks

            shortTP      := tpValue
            shortRangeRR := rValue > 0 ? rangeAvail / rValue : na
            shortEntry   := entryPrice
            shortR       := rValue
            shortTradeOk := rValue > 0 and rangeOk and not rTooLarge

            string reasonTextS = ""
            if not rangeOk
                reasonTextS := reasonTextS + "Range " + f_fmtRR(rangeAvail / rValue) + "R < " + str.tostring(minRangeRR, "#.##") + "R (" + str.tostring(rangeAvail, format.mintick) + " < " + str.tostring(rangeNeeded, format.mintick) + ")"
            if rTooLarge
                if reasonTextS != ""
                    reasonTextS := reasonTextS + "\n"
                reasonTextS := reasonTextS + "R " + str.tostring(rTicks, "#.##") + " ticks > max " + str.tostring(maxRTicks) + " ticks"
            shortReasonText := reasonTextS

    [resistance, support, targetResistance, targetSupport,
     rFallback, sFallback, trFallback, tsFallback,
     rPivotTime, sPivotTime, trPivotTime, tsPivotTime,
     rBarsBack, sBarsBack, trBarsBack, tsBarsBack,
     barTime, rightEdgeTime,
     longActive, shortActive,
     longTrailSL, shortTrailSL, slSide,
     longBreakLevel, shortBreakLevel, breakTime, breakSide,
     breakLow, breakHigh,
     longTradeOk, longTP, longReasonText, longRangeRR, longEntry, longR,
     shortTradeOk, shortTP, shortReasonText, shortRangeRR, shortEntry, shortR]

// Let op: request.security() krijgt hier bewust een TUPLE van simpele
// waarden terug (niet een object van een user-defined type). Dat is de
// vorm die request.security() al sinds jaar en dag ondubbelzinnig
// ondersteunt; een UDT-object teruggeven bleek in de praktijk niet
// betrouwbaar te worden gevuld (alle velden bleven op hun startwaarde
// staan, waardoor er nergens meer iets werd getekend).
[calcResistance, calcSupport, calcTargetResistance, calcTargetSupport, calcRFallback, calcSFallback, calcTrFallback, calcTsFallback, calcRPivotTime, calcSPivotTime, calcTrPivotTime, calcTsPivotTime, calcRBarsBack, calcSBarsBack, calcTrBarsBack, calcTsBarsBack, calcBarTime, calcRightEdgeTime, calcLongActive, calcShortActive, calcLongTrailSL, calcShortTrailSL, calcSlSide, calcLongBreakLevel, calcShortBreakLevel, calcBreakTime, calcBreakSide, calcBreakLow, calcBreakHigh, calcLongTradeOk, calcLongTP, calcLongReasonText, calcLongRangeRR, calcLongEntry, calcLongR, calcShortTradeOk, calcShortTP, calcShortReasonText, calcShortRangeRR, calcShortEntry, calcShortR] = request.security(syminfo.tickerid, calcTF, f_calc30m(), lookahead=barmerge.lookahead_off)

// ============================================================
// Waarschuwing bij niet-ondersteund timeframe.
// ============================================================
var label tfWarnLabel = na
if barstate.islast
    if not isSupportedTF
        if na(tfWarnLabel)
            tfWarnLabel := label.new(bar_index, high, "Trade Lijnen: alleen 30m en 15m worden ondersteund.\nSchakel naar 30m of 15m.", xloc.bar_index, yloc.abovebar, color.new(color.red, 0), label.style_label_down, color.white, size.normal)
    else if not na(tfWarnLabel)
        label.delete(tfWarnLabel)
        tfWarnLabel := na

// newData wordt precies 1x waar bij het sluiten van elke nieuwe 30m-candle,
// ongeacht of de chart zelf op 30m of 15m staat - dat is het moment waarop
// alle lijnen/labels hieronder herbouwd worden.
var int lastDrawnBarTime = na
newData = isSupportedTF and not na(calcBarTime) and (na(lastDrawnBarTime) or calcBarTime != lastDrawnBarTime)

// ============================================================
// FREEZE: als "Lijnen bevriezen zodra een geldige trade ontstaat" aan staat,
// blijven ALLE lijnen/labels precies staan zoals ze waren op het moment dat
// er een geldige long/short trade ontstond (calcLongTradeOk/calcShortTradeOk
// bij een actief signaal). Vanaf dat moment wordt er niet meer bijgewerkt,
// ook niet bij volgende 30m-candles, totdat de gebruiker deze instelling
// handmatig uit- en weer aanzet (dat "reset" de bevriezing, zodat de
// volgende geldige trade opnieuw bevroren wordt).
// ============================================================
var bool linesFrozen = false
if not freezeOnValidTrade
    linesFrozen := false

effectiveNewData = newData and not linesFrozen

// ============================================================
// DIAGNOSEPANEEL (uit te zetten via de instelling hierboven). Toont de
// kernwaarden die request.security() teruggeeft, zodat zichtbaar is of
// calc* echt gevuld wordt en of newData ooit true wordt.
// ============================================================
var table dbgTable = table.new(position.top_right, 1, 1)
if debugCalcPanel and barstate.islast
    dbgText = "isSupportedTF=" + str.tostring(isSupportedTF) +
      "\ntimeframe.period=" + timeframe.period +
      "\ncalcBarTime=" + str.tostring(calcBarTime) +
      "\ncalcResistance=" + str.tostring(calcResistance) +
      "\ncalcSupport=" + str.tostring(calcSupport) +
      "\nnewData=" + str.tostring(newData) +
      "\nlinesFrozen=" + str.tostring(linesFrozen) +
      "\nlastDrawnBarTime=" + str.tostring(lastDrawnBarTime) +
      "\nbar_index=" + str.tostring(bar_index)
    table.cell(dbgTable, 0, 0, dbgText, bgcolor=color.new(color.yellow, 20), text_color=color.black, text_size=size.small)
else if barstate.islast
    table.cell(dbgTable, 0, 0, "")

// ============================================================
// Resistance / Support / Target-lijnen + labels.
// ============================================================
var line  rLine       = na
var line  sLine       = na
var line  trLine      = na
var line  tsLine      = na
var label rNameLabel  = na
var label sNameLabel  = na
var label trNameLabel = na
var label tsNameLabel = na

if effectiveNewData and not na(calcResistance)
    if not na(rLine)
        line.delete(rLine)
    if not na(sLine)
        line.delete(sLine)
    if not na(trLine)
        line.delete(trLine)
    if not na(tsLine)
        line.delete(tsLine)
    if not na(rNameLabel)
        label.delete(rNameLabel)
    if not na(sNameLabel)
        label.delete(sNameLabel)
    if not na(trNameLabel)
        label.delete(trNameLabel)
    if not na(tsNameLabel)
        label.delete(tsNameLabel)

    rLine  := line.new(calcRPivotTime, calcResistance, calcBarTime, calcResistance, xloc.bar_time, extend.right, color.new(color.red, 0), line.style_solid, 2)
    sLine  := line.new(calcSPivotTime, calcSupport, calcBarTime, calcSupport, xloc.bar_time, extend.right, color.new(color.green, 0), line.style_solid, 2)
    trLine := line.new(calcTrPivotTime, calcTargetResistance, calcBarTime, calcTargetResistance, xloc.bar_time, extend.right, color.new(color.red, 40), line.style_solid, 2)
    tsLine := line.new(calcTsPivotTime, calcTargetSupport, calcBarTime, calcTargetSupport, xloc.bar_time, extend.right, color.new(color.green, 40), line.style_solid, 2)

    rNameLabel  := label.new(calcBarTime, calcResistance, "Resistance" + (calcRFallback ? " [FALLBACK]" : " [pivot " + str.tostring(calcRBarsBack) + " candles terug]"), xloc.bar_time, yloc.price, color.new(color.red, 100), label.style_label_left, labelTextColor, size.small)
    sNameLabel  := label.new(calcBarTime, calcSupport, "Support" + (calcSFallback ? " [FALLBACK]" : " [pivot " + str.tostring(calcSBarsBack) + " candles terug]"), xloc.bar_time, yloc.price, color.new(color.green, 100), label.style_label_left, labelTextColor, size.small)
    trNameLabel := label.new(calcBarTime, calcTargetResistance, "Target Resistance" + (calcTrFallback ? " [FALLBACK]" : " [pivot " + str.tostring(calcTrBarsBack) + " candles terug]"), xloc.bar_time, yloc.price, color.new(color.red, 100), label.style_label_left, labelTextColor, size.small)
    tsNameLabel := label.new(calcBarTime, calcTargetSupport, "Target Support" + (calcTsFallback ? " [FALLBACK]" : " [pivot " + str.tostring(calcTsBarsBack) + " candles terug]"), xloc.bar_time, yloc.price, color.new(color.green, 100), label.style_label_left, labelTextColor, size.small)

// ============================================================
// Break-lijn + LONG/SHORT signaallabel.
// ============================================================
var line  longBreakLine   = na
var line  shortBreakLine  = na
var label longBreakLabel  = na
var label shortBreakLabel = na
var label signalLabel     = na

if effectiveNewData
    if (not calcLongActive or not calcBreakSide) and not na(longBreakLine)
        line.delete(longBreakLine)
        longBreakLine := na
    if (not calcLongActive or not calcBreakSide) and not na(longBreakLabel)
        label.delete(longBreakLabel)
        longBreakLabel := na
    if (not calcShortActive or calcBreakSide) and not na(shortBreakLine)
        line.delete(shortBreakLine)
        shortBreakLine := na
    if (not calcShortActive or calcBreakSide) and not na(shortBreakLabel)
        label.delete(shortBreakLabel)
        shortBreakLabel := na
    if not calcLongActive and not calcShortActive and not na(signalLabel)
        label.delete(signalLabel)
        signalLabel := na

    if calcLongActive and calcBreakSide
        if not na(longBreakLine)
            line.delete(longBreakLine)
        longBreakLine := line.new(calcBreakTime, calcLongBreakLevel, calcRightEdgeTime, calcLongBreakLevel, xloc.bar_time, extend.left, color.black, line.style_dashed, 1)
        if not na(longBreakLabel)
            label.delete(longBreakLabel)
        longBreakLabel := label.new(calcRightEdgeTime, calcLongBreakLevel, "Resistance doorbroken: " + str.tostring(calcLongBreakLevel, format.mintick), xloc.bar_time, yloc.price, color.new(color.black, 100), label.style_label_left, labelTextColor, size.small)
        if not na(signalLabel)
            label.delete(signalLabel)
        signalLabel := label.new(calcBreakTime, calcBreakLow - 10 * tickSize, "", xloc.bar_time, yloc.price, color.new(color.green, 0), label.style_arrowup, color.black, size.normal)

    if calcShortActive and not calcBreakSide
        if not na(shortBreakLine)
            line.delete(shortBreakLine)
        shortBreakLine := line.new(calcBreakTime, calcShortBreakLevel, calcRightEdgeTime, calcShortBreakLevel, xloc.bar_time, extend.left, color.black, line.style_dashed, 1)
        if not na(shortBreakLabel)
            label.delete(shortBreakLabel)
        shortBreakLabel := label.new(calcRightEdgeTime, calcShortBreakLevel, "Support doorbroken: " + str.tostring(calcShortBreakLevel, format.mintick), xloc.bar_time, yloc.price, color.new(color.black, 100), label.style_label_left, labelTextColor, size.small)
        if not na(signalLabel)
            label.delete(signalLabel)
        signalLabel := label.new(calcBreakTime, calcBreakHigh + 10 * tickSize, "", xloc.bar_time, yloc.price, color.new(color.red, 0), label.style_arrowdown, color.black, size.normal)

// ============================================================
// SL-lijn (trailing binnen het signaalvenster).
// ============================================================
var line  longLine   = na
var line  shortLine  = na
var label longLabel  = na
var label shortLabel = na

if showSL and effectiveNewData
    if (not calcLongActive or not calcSlSide) and not na(longLine)
        line.delete(longLine)
        longLine := na
    if (not calcLongActive or not calcSlSide) and not na(longLabel)
        label.delete(longLabel)
        longLabel := na
    if (not calcShortActive or calcSlSide) and not na(shortLine)
        line.delete(shortLine)
        shortLine := na
    if (not calcShortActive or calcSlSide) and not na(shortLabel)
        label.delete(shortLabel)
        shortLabel := na

    if calcLongActive and calcSlSide and not na(calcLongTrailSL)
        if not na(longLine)
            line.delete(longLine)
        longLine := line.new(calcBreakTime, calcLongTrailSL, calcRightEdgeTime, calcLongTrailSL, xloc.bar_time, extend.none, longColor, line.style_dashed, 2)
        if not na(longLabel)
            label.delete(longLabel)
        longTradeBlocked = showTradeCheck and calcBreakSide and not calcLongTradeOk and calcLongReasonText != ""
        longLabelText  = "Long SL: " + str.tostring(calcLongTrailSL, format.mintick) + (longTradeBlocked ? "\nTrade niet mogelijk: " + calcLongReasonText : "")
        longLabelColor = longTradeBlocked ? noTradeColor : longColor
        longLabel := label.new(calcRightEdgeTime, calcLongTrailSL, longLabelText, xloc.bar_time, yloc.price, color.new(longLabelColor, longTradeBlocked ? 0 : 80), label.style_label_left, longTradeBlocked ? color.black : longColor, size.small)

    if calcShortActive and not calcSlSide and not na(calcShortTrailSL)
        if not na(shortLine)
            line.delete(shortLine)
        shortLine := line.new(calcBreakTime, calcShortTrailSL, calcRightEdgeTime, calcShortTrailSL, xloc.bar_time, extend.none, shortColor, line.style_dashed, 2)
        if not na(shortLabel)
            label.delete(shortLabel)
        shortTradeBlocked = showTradeCheck and not calcBreakSide and not calcShortTradeOk and calcShortReasonText != ""
        shortLabelText  = "Short SL: " + str.tostring(calcShortTrailSL, format.mintick) + (shortTradeBlocked ? "\nTrade niet mogelijk: " + calcShortReasonText : "")
        shortLabelColor = shortTradeBlocked ? noTradeColor : shortColor
        shortLabel := label.new(calcRightEdgeTime, calcShortTrailSL, shortLabelText, xloc.bar_time, yloc.price, color.new(shortLabelColor, shortTradeBlocked ? 0 : 80), label.style_label_left, shortTradeBlocked ? color.black : shortColor, size.small)

// ============================================================
// TP-lijn. Vereist zowel showSL als showTradeCheck: de TP is afgeleid van
// de SL/R-berekening, dus zonder SL-lijn heeft een losse TP-lijn geen context.
// ============================================================
var line  tpLine       = na
var label tpLabel      = na

if showSL and showTradeCheck and effectiveNewData
    if not calcLongActive and not calcShortActive
        if not na(tpLine)
            line.delete(tpLine)
            tpLine := na
        if not na(tpLabel)
            label.delete(tpLabel)
            tpLabel := na

    if calcLongActive and calcBreakSide
        if not na(tpLine)
            line.delete(tpLine)
            tpLine := na
        if not na(tpLabel)
            label.delete(tpLabel)
            tpLabel := na
        if calcLongTradeOk
            tpLine  := line.new(calcBreakTime, calcLongTP, calcRightEdgeTime, calcLongTP, xloc.bar_time, extend.none, tpColor, line.style_dashed, 2)
            tpLabel := label.new(calcRightEdgeTime, calcLongTP, "TP (" + str.tostring(tpRR, "#.##") + " R/R): " + str.tostring(calcLongTP, format.mintick) + " · Entry " + str.tostring(calcLongEntry, format.mintick) + " · R " + str.tostring(calcLongR, format.mintick) + " · Range " + f_fmtRR(calcLongRangeRR) + "R", xloc.bar_time, yloc.price, color.new(tpColor, 80), label.style_label_left, tpColor, size.small)

    if calcShortActive and not calcBreakSide
        if not na(tpLine)
            line.delete(tpLine)
            tpLine := na
        if not na(tpLabel)
            label.delete(tpLabel)
            tpLabel := na
        if calcShortTradeOk
            tpLine  := line.new(calcBreakTime, calcShortTP, calcRightEdgeTime, calcShortTP, xloc.bar_time, extend.none, tpColor, line.style_dashed, 2)
            tpLabel := label.new(calcRightEdgeTime, calcShortTP, "TP (" + str.tostring(tpRR, "#.##") + " R/R): " + str.tostring(calcShortTP, format.mintick) + " · Entry " + str.tostring(calcShortEntry, format.mintick) + " · R " + str.tostring(calcShortR, format.mintick) + " · Range " + f_fmtRR(calcShortRangeRR) + "R", xloc.bar_time, yloc.price, color.new(tpColor, 80), label.style_label_left, tpColor, size.small)

if effectiveNewData
    lastDrawnBarTime := calcBarTime
    // Pas NA het tekenen bevriezen, zodat de lijnen van de geldige trade
    // zelf nog wel normaal getekend worden op de signaal-candle. Alleen op
    // de actuele/laatste bar (barstate.islast) laten "vastklikken": anders
    // zou het aanvinken van deze optie het script vanaf bar 0 laten
    // herberekenen en al bij de EERSTE geldige trade ooit in de geschiedenis
    // voorgoed bevriezen, ruim voordat het huidige chart-venster begint -
    // met als zichtbaar gevolg dat alle lijnen leken te verdwijnen.
    if freezeOnValidTrade and barstate.islast and ((calcLongActive and calcBreakSide and calcLongTradeOk) or (calcShortActive and not calcBreakSide and calcShortTradeOk))
        linesFrozen := true

// ============================================================
// Alerts - vuren éénmalig per nieuw 30m-signaal, ongeacht of je op 30m of
// 15m kijkt (het duurt hooguit tot de eerstvolgende bar van de huidige
// chart voordat de bijgewerkte 30m-waarde binnenkomt).
// ============================================================
var int lastAlertedBreakTime = na
if isSupportedTF and not na(calcBreakTime) and (na(lastAlertedBreakTime) or calcBreakTime != lastAlertedBreakTime)
    if calcLongActive and calcBreakSide
        alert("Bullish breakout: close boven Resistance + " + str.tostring(xTicks) + " ticks", alert.freq_once_per_bar_close)
        lastAlertedBreakTime := calcBreakTime
    else if calcShortActive and not calcBreakSide
        alert("Bearish breakdown: close onder Support - " + str.tostring(xTicks) + " ticks", alert.freq_once_per_bar_close)
        lastAlertedBreakTime := calcBreakTime

// ============================================================
// DEBUG: alleen zichtbaar op de native 30m-chart (bar_index-gebaseerd,
// exact zoals in v1.8.2). Dit is een handmatig vergelijkingshulpmiddel voor
// Support-pivot-detectie tussen databronnen en hoeft niet naar 15m mee te
// volgen.
// ============================================================
var label debugCandidateLabel = na
var label debugRejectLabel    = na

if timeframe.period == calcTF and barstate.isconfirmed
    if not na(debugCandidateLabel)
        label.delete(debugCandidateLabel)
        debugCandidateLabel := na
    if not na(debugRejectLabel)
        label.delete(debugRejectLabel)
        debugRejectLabel := na

    if debugSupportPivot
        [dbgLevel, dbgPivotBar, dbgRejectBar, dbgRejectLevel] = f_debugFirstSupportCandidate(maxScanBars, excludeReversalCandle)
        if not na(dbgLevel)
            debugCandidateLabel := label.new(dbgPivotBar, dbgLevel, "Support-kandidaat: " + str.tostring(dbgLevel, format.mintick) + (na(dbgRejectBar) ? " [GELDIG]" : " [VERWORPEN]"), xloc.bar_index, yloc.price, color.new(color.orange, 60), label.style_circle, color.new(color.black, 0), size.small)
        if not na(dbgRejectBar)
            debugRejectLabel := label.new(dbgRejectBar, dbgRejectLevel, "Breekt hier: " + str.tostring(dbgRejectLevel, format.mintick), xloc.bar_index, yloc.price, color.new(color.orange, 60), label.style_circle, color.new(color.black, 0), size.small)
